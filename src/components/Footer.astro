---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import type { IconName } from "../data/icons";

const year = new Date().getFullYear();

const linkGroups = [
  {
    title: "HELP",
    titleClass: "text-nexus-primary",
    links: [
      { label: "FAQ", href: "/faq" },
      { label: "Contact", href: "/contact" },
      { label: "Support", href: "/support" },
    ],
  },
  {
    title: "LEGAL",
    titleClass: "text-nexus-primary",
    links: [
      { label: "Terms", href: "/terms" },
      { label: "Privacy", href: "/privacy" },
      { label: "Cookies", href: "/cookies" },
    ],
  },
  {
    title: "CONNECT",
    titleClass: "text-nexus-accent",
    links: [
      { label: "Twitter", href: "#" },
      { label: "Discord", href: "#" },
      { label: "Instagram", href: "#" },
    ],
  },
];

const socials: { name: IconName; label: string }[] = [
  { name: "twitter", label: "Twitter" },
  { name: "discord", label: "Discord" },
  { name: "instagram", label: "Instagram" },
];
---

<footer
  class="border-nexus-surface bg-nexus-background relative mt-16 overflow-hidden border-t pt-12 pb-6"
>
  <!-- Línea de glow sobre el borde -->
  <div
    class="via-nexus-accent/40 absolute top-0 right-0 left-0 h-[1px] bg-gradient-to-r from-transparent to-transparent"
  >
  </div>

  <div class="container mx-auto px-4 lg:px-6">
    <div
      class="mb-10 flex flex-col items-start justify-between gap-12 md:flex-row md:items-center"
    >
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <a href="/" aria-label="Hernán Cubillos Store – Home">
          <Logo accent="#9fcc2e" size="lg" />
        </a>

        <p
          class="text-nexus-muted border-nexus-surface/50 hidden border-l py-2 pl-3 text-[13px] sm:block"
        >
          &copy; {year} Hernán Cubillos. Portfolio project.
        </p>
      </div>

      <p class="text-nexus-muted text-[13px] sm:hidden">
        &copy; {year} Hernán Cubillos. Portfolio project.
      </p>

      <!-- Menu Links -->
      <div
        class="flex w-full flex-wrap justify-between gap-12 md:w-auto md:flex-nowrap lg:justify-end lg:gap-24"
      >
        {
          linkGroups.map((group) => (
            <div class={group.title === "CONNECT" ? "hidden sm:block" : ""}>
              <h3
                class={`${group.titleClass} mb-4 text-sm font-bold tracking-widest uppercase`}
              >
                {group.title}
              </h3>
              <ul class="space-y-3 text-[15px]">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="hover:text-nexus-accent text-white transition-colors"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Socials & Scroll Top -->
      <div
        class="mt-4 flex items-center gap-4 self-start md:mt-0 md:self-center"
      >
        {
          socials.map((social) => (
            <a
              href="#"
              class="text-nexus-accent p-1 transition-colors hover:text-white"
              aria-label={social.label}
            >
              <Icon name={social.name} size={22} />
            </a>
          ))
        }

        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="bg-nexus-primary text-nexus-background hover:text-nexus-primary hover:bg-nexus-surface relative ml-4 flex items-center justify-center rounded-lg p-2 shadow-[0_0_10px_rgba(159,204,46,0.5)] transition-all"
          aria-label="Back to top"
        >
          <Icon name="chevron-up" size={20} strokeWidth={2.5} />
        </button>
      </div>
    </div>
  </div>
</footer>
