---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import GameCard from "../components/GameCard.astro";
import GameSliderCard from "../components/GameSliderCard.astro";
import GenreCard from "../components/GenreCard.astro";
import { genres } from "../data/genres";

const allGames = await getCollection("games");

const featuredGame = allGames.find((game) => game.data.featured) ?? allGames[0];
const newGames = allGames.filter((game) => game.data.isNew);
const deals = allGames
  .filter((game) => game.data.discountPercent)
  .sort(
    (a, b) => (b.data.discountPercent ?? 0) - (a.data.discountPercent ?? 0),
  );
const catalog = [...allGames].sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Layout title="Explore Limitless Worlds">
  <div class="container mx-auto space-y-16 px-4 py-8 lg:px-6">
    <!-- Hero Section -->
    <section
      class="bg-nexus-surface border-nexus-surface/80 relative flex h-[500px] flex-col items-stretch overflow-hidden rounded-[2rem] border shadow-lg md:flex-row"
    >
      <!-- Hero Content (Left) -->
      <div
        class="from-nexus-background via-nexus-background/95 relative z-10 flex flex-1 flex-col justify-center bg-gradient-to-r to-transparent p-10 md:p-16"
      >
        <h1
          class="font-display mb-4 text-4xl leading-[1.1] font-black tracking-tight text-white md:text-5xl lg:text-6xl"
        >
          A NEW <br />ERA OF ADVENTURE BEGINS.
        </h1>
        <p
          class="text-nexus-muted mb-10 max-w-md text-lg font-medium md:text-xl"
        >
          Explore limitless worlds. {
            featuredGame.data.preorder ? "Pre-order" : "Play"
          }
          {featuredGame.data.title} today.
        </p>
        <div>
          <a
            href={`/game/${featuredGame.id}`}
            class="bg-nexus-primary text-nexus-background hover:text-nexus-primary hover:shadow-neon-lime shadow-neon-lime inline-block cursor-pointer rounded-lg px-8 py-3.5 text-center text-sm font-bold tracking-widest uppercase transition-all duration-500 hover:scale-102 hover:bg-white active:scale-95"
          >
            {featuredGame.data.preorder ? "PRE-ORDER NOW" : "BUY NOW"}
          </a>
        </div>
      </div>

      <!-- Hero Image (Right) -->
      <div class="absolute inset-0 h-full md:relative md:inset-auto md:w-3/5">
        <img
          src={featuredGame.data.image}
          alt={featuredGame.data.title}
          class="h-full w-full object-cover object-right-top"
        />
        <div
          class="from-nexus-background absolute inset-0 bg-gradient-to-t via-transparent to-transparent md:hidden"
        >
        </div>
        <div
          class="from-nexus-background via-nexus-background/50 absolute inset-0 hidden bg-gradient-to-r to-transparent md:block"
        >
        </div>
        <!-- Glow overlay -->
        <div class="bg-nexus-teal/20 absolute inset-0 mix-blend-color-dodge">
        </div>
      </div>
    </section>

    <!-- EXPLORE BY GENRE -->
    <section id="genres">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        EXPLORE BY GENRE
      </h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:gap-6">
        {genres.map((genre) => <GenreCard genre={genre} />)}
      </div>
    </section>

    <!-- NEW RELEASES SLIDER -->
    <section>
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        NEW RELEASES
      </h2>
      <div
        class="splide group/slider relative w-full"
        id="new-games-slider"
        aria-label="New releases"
      >
        <!-- Custom Arrows -->
        <div
          class="splide__arrows pointer-events-none absolute inset-y-0 right-0 left-0 z-10 md:-mx-6"
        >
          <button
            class="splide__arrow splide__arrow--prev bg-nexus-primary border-nexus-surface hover:bg-nexus-accent hover:shadow-neon-peach text-nexus-background pointer-events-auto absolute top-1/2 -left-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 opacity-0 transition-all duration-300 group-hover/slider:opacity-100 md:-left-8 md:h-16 md:w-16 md:border-4"
          >
            <Icon name="chevron-left" size={24} strokeWidth={3} />
          </button>
          <button
            class="splide__arrow splide__arrow--next bg-nexus-primary border-nexus-surface hover:bg-nexus-accent hover:shadow-neon-peach text-nexus-background pointer-events-auto absolute top-1/2 -right-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 opacity-0 transition-all duration-300 group-hover/slider:opacity-100 md:-right-8 md:h-16 md:w-16 md:border-4"
          >
            <Icon name="chevron-right" size={24} strokeWidth={3} />
          </button>
        </div>

        <div class="splide__track w-full pb-10">
          <ul class="splide__list">
            {
              newGames.map((game) => (
                <li class="splide__slide">
                  <GameSliderCard game={game} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- HOT DEALS -->
    <section id="deals">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        HOT DEALS
      </h2>
      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-4 lg:gap-6"
      >
        {deals.map((game) => <GameCard game={game} />)}
      </div>
    </section>

    <!-- ALL GAMES -->
    <section id="store">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        ALL GAMES
      </h2>
      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-4 lg:gap-6"
      >
        {catalog.map((game) => <GameCard game={game} />)}
      </div>
    </section>
  </div>
</Layout>

<script>
  import Splide from "@splidejs/splide";
  import "@splidejs/splide/css/core";

  // Slider de nuevos lanzamientos (los scripts de Astro corren como módulos
  // después de parsear el DOM, no hace falta esperar a DOMContentLoaded)
  const sliderEl = document.getElementById("new-games-slider");

  if (sliderEl) {
    new Splide(sliderEl, {
      type: "loop",
      perPage: 1,
      perMove: 1,
      gap: "24px",
      pagination: true,
      arrows: true,
      autoplay: true,
      interval: 4000,
      pauseOnHover: true,
    }).mount();
  }
</script>
