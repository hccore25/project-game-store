# Base de datos (libSQL / Turso)
# Desarrollo local: archivo SQLite, sin cuenta ni token.
DATABASE_URL="file:./local.db"
# DATABASE_AUTH_TOKEN=

# Producción (Turso):
# DATABASE_URL="libsql://<tu-db>.turso.io"
# DATABASE_AUTH_TOKEN="<token de turso>"

# Usuario del panel de administración (/admin).
# Se aplican con: pnpm admin:create
ADMIN_EMAIL="admin@nexusstore.dev"
ADMIN_PASSWORD="cambiala-por-favor"
