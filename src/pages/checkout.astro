---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const inputClass =
  "border-nexus-surface bg-nexus-surface/30 text-nexus-text placeholder:text-nexus-muted/60 focus:border-nexus-primary w-full rounded-lg border px-4 py-3 text-sm focus:outline-none";
---

<Layout title="Checkout" description="Complete your simulated purchase.">
  <div class="container mx-auto px-4 py-8 lg:px-6">
    <h1
      class="font-display mb-8 text-3xl font-black tracking-widest text-white uppercase"
    >
      CHECKOUT
    </h1>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
      <!-- Payment form -->
      <form id="checkout-form" class="space-y-6 lg:col-span-3" novalidate>
        <div
          class="bg-nexus-teal/20 border-nexus-teal text-nexus-accent flex items-center gap-3 rounded-xl border p-4 text-sm"
        >
          <Icon name="key" size={18} />
          <span>
            Demo store — no real payment is processed. Use test card
            <strong class="text-white">4242 4242 4242 4242</strong>.
          </span>
        </div>

        <div>
          <label
            for="field-name"
            class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
            >Full name</label
          >
          <input
            id="field-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Aether Striker"
            class={inputClass}
          />
          <p class="field-error text-nexus-accent mt-1 hidden text-xs">
            Enter your full name.
          </p>
        </div>

        <div>
          <label
            for="field-email"
            class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
            >Email (game keys will be "sent" here)</label
          >
          <input
            id="field-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="player@nexus.gg"
            class={inputClass}
          />
          <p class="field-error text-nexus-accent mt-1 hidden text-xs">
            Enter a valid email address.
          </p>
        </div>

        <div>
          <label
            for="field-card"
            class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
            >Card number</label
          >
          <input
            id="field-card"
            name="card"
            inputmode="numeric"
            autocomplete="cc-number"
            maxlength="19"
            placeholder="4242 4242 4242 4242"
            class={inputClass}
          />
          <p class="field-error text-nexus-accent mt-1 hidden text-xs">
            Enter a 16-digit card number.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label
              for="field-expiry"
              class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
              >Expiry (MM/YY)</label
            >
            <input
              id="field-expiry"
              name="expiry"
              inputmode="numeric"
              autocomplete="cc-exp"
              maxlength="5"
              placeholder="12/28"
              class={inputClass}
            />
            <p class="field-error text-nexus-accent mt-1 hidden text-xs">
              Enter a valid future date.
            </p>
          </div>
          <div>
            <label
              for="field-cvc"
              class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
              >CVC</label
            >
            <input
              id="field-cvc"
              name="cvc"
              inputmode="numeric"
              autocomplete="cc-csc"
              maxlength="4"
              placeholder="123"
              class={inputClass}
            />
            <p class="field-error text-nexus-accent mt-1 hidden text-xs">
              3 or 4 digits.
            </p>
          </div>
        </div>

        <p
          id="checkout-error"
          class="border-nexus-accent bg-nexus-accent/10 text-nexus-accent hidden rounded-lg border px-4 py-3 text-sm"
        >
        </p>

        <button
          id="pay-button"
          type="submit"
          class="bg-nexus-primary text-nexus-background shadow-neon-lime w-full rounded-lg px-6 py-4 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="pay-label">PAY NOW</span>
        </button>
      </form>

      <!-- Order summary -->
      <aside
        class="bg-nexus-surface/30 border-nexus-surface h-fit rounded-2xl border p-6 lg:col-span-2"
      >
        <h2
          class="text-nexus-muted mb-6 text-sm font-bold tracking-widest uppercase"
        >
          ORDER SUMMARY
        </h2>
        <ul id="checkout-items" class="mb-6 space-y-3 text-sm"></ul>
        <div
          class="border-nexus-surface flex justify-between border-t pt-4 text-base"
        >
          <span class="font-bold text-white">Total</span>
          <span
            id="checkout-total"
            class="text-nexus-primary font-display font-black"></span>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import { getCart, cartTotal, clearCart } from "../utils/store";
    import { formatPrice } from "../utils/format";

    const cart = getCart();

    // Sin carrito no hay checkout
    if (cart.length === 0) {
      window.location.replace("/cart");
    }

    // --- Resumen ---
    const itemsList = document.getElementById("checkout-items");
    const totalEl = document.getElementById("checkout-total");

    if (itemsList && totalEl) {
      for (const item of cart) {
        const li = document.createElement("li");
        li.className = "flex justify-between gap-4";

        const name = document.createElement("span");
        name.className = "text-nexus-muted truncate";
        name.textContent = `${item.title} × ${item.qty}`;

        const price = document.createElement("span");
        price.className = "shrink-0 font-bold text-white";
        price.textContent = formatPrice(item.price * item.qty);

        li.append(name, price);
        itemsList.append(li);
      }
      totalEl.textContent = formatPrice(cartTotal());

      const payLabel = document.getElementById("pay-label");
      if (payLabel) payLabel.textContent = `PAY ${formatPrice(cartTotal())}`;
    }

    // --- Validación y pago simulado ---
    const form = document.getElementById(
      "checkout-form",
    ) as HTMLFormElement | null;
    const payButton = document.getElementById(
      "pay-button",
    ) as HTMLButtonElement | null;

    const validators: Record<string, (value: string) => boolean> = {
      "field-name": (v) => v.trim().length >= 3,
      "field-email": (v) => /^\S+@\S+\.\S+$/.test(v.trim()),
      "field-card": (v) => /^\d{16}$/.test(v.replace(/\s/g, "")),
      "field-expiry": (v) => {
        const match = v.trim().match(/^(0[1-9]|1[0-2])\/(\d{2})$/);
        if (!match) return false;
        const expiry = new Date(2000 + Number(match[2]), Number(match[1]), 0);
        return expiry >= new Date();
      },
      "field-cvc": (v) => /^\d{3,4}$/.test(v.trim()),
    };

    const validateField = (id: string): boolean => {
      const input = document.getElementById(id) as HTMLInputElement | null;
      if (!input) return false;
      const valid = validators[id](input.value);
      input.classList.toggle("border-nexus-accent", !valid);
      input
        .closest("div")
        ?.querySelector(".field-error")
        ?.classList.toggle("hidden", valid);
      return valid;
    };

    // Formateo en vivo: agrupa la tarjeta en bloques de 4 y la expiración en
    // MM/AA, reduciendo errores al probar con la tarjeta demo. La validación
    // ya tolera espacios, así que estos listeners no la rompen.
    const cardInput = document.getElementById("field-card");
    cardInput?.addEventListener("input", () => {
      const digits = (cardInput as HTMLInputElement).value.replace(/\D/g, "").slice(0, 16);
      (cardInput as HTMLInputElement).value = digits
        .replace(/(\d{4})(?=\d)/g, "$1 ")
        .trim();
    });
    const expiryInput = document.getElementById("field-expiry");
    expiryInput?.addEventListener("input", () => {
      const digits = (expiryInput as HTMLInputElement).value.replace(/\D/g, "").slice(0, 4);
      (expiryInput as HTMLInputElement).value =
        digits.length > 2 ? `${digits.slice(0, 2)}/${digits.slice(2)}` : digits;
    });

    const errorBox = document.getElementById("checkout-error");
    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
    };

    const label = document.getElementById("pay-label");
    const resetButton = () => {
      if (payButton) payButton.disabled = false;
      if (label) label.textContent = `PAY ${formatPrice(cartTotal())}`;
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox?.classList.add("hidden");

      const allValid = Object.keys(validators)
        .map(validateField)
        .every(Boolean);
      if (!allValid || !payButton) return;

      payButton.disabled = true;
      if (label) label.textContent = "PROCESSING PAYMENT...";

      const name = (
        document.getElementById("field-name") as HTMLInputElement
      ).value.trim();
      const email = (
        document.getElementById("field-email") as HTMLInputElement
      ).value.trim();

      // El pago es simulado: solo esperamos un momento para dar feedback.
      await new Promise((resolve) => setTimeout(resolve, 1200));

      try {
        const response = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            email,
            items: getCart().map((item) => ({
              slug: item.slug,
              qty: item.qty,
            })),
          }),
        });
        const data = (await response.json()) as {
          ok?: boolean;
          orderId?: string;
          error?: string;
        };

        if (!response.ok || !data.orderId) {
          showError(data.error ?? "No se pudo completar el pedido.");
          resetButton();
          return;
        }

        clearCart();
        window.location.href = `/order-confirmation/${data.orderId}`;
      } catch {
        showError("Error de red. Intentá de nuevo.");
        resetButton();
      }
    });
  </script>
</Layout>
