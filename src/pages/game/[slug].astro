---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Toast from "../../components/Toast.astro";
import PriceDisplay from "../../components/PriceDisplay.astro";
import { finalPrice } from "../../utils/format";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

interface Props {
  game: CollectionEntry<"games">;
}

const { game } = Astro.props;
const {
  title,
  description,
  price,
  discountPercent,
  image,
  gallery,
  genres,
  developer,
  releaseDate,
  platforms,
  rating,
  systemReq,
} = game.data;

const [titleMain, titleSub] = title.split(": ");
const galleryImages = gallery.length > 0 ? gallery : [image];
const unitPrice = finalPrice(price, discountPercent);
---

<Layout title={title} description={description} image={image}>
  <div class="container mx-auto px-4 py-8 lg:px-6">
    <!-- Breadcrumb / Back Navigation -->
    <div class="mb-8">
      <a
        href="/"
        class="text-nexus-muted flex items-center gap-2 text-sm font-bold tracking-widest uppercase transition-colors hover:text-white"
      >
        <Icon name="arrow-left" size={16} />
        BACK TO STORE
      </a>
    </div>

    <!-- Asymmetric Layout Container -->
    <div
      class="relative grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12"
    >
      <!-- LEFT COLUMN: Artwork -->
      <div class="lg:sticky lg:top-28 lg:col-span-5">
        <!-- Main Artwork Card -->
        <div
          class="border-nexus-surface relative aspect-[3/4] overflow-hidden rounded-[2rem] border shadow-[0_0_30px_rgba(0,0,0,0.5)]"
        >
          <Image
            id="main-artwork"
            src={image}
            alt={title}
            width={900}
            height={1200}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover transition-opacity duration-300"
          />
          <div
            class="from-nexus-background via-nexus-background/20 absolute inset-0 bg-gradient-to-t to-transparent"
          >
          </div>

          <!-- Title Over Image (Bottom) -->
          <div class="absolute right-0 bottom-0 left-0 p-8">
            <h1
              class="font-display mb-2 text-3xl leading-[1.1] font-black tracking-tight text-white drop-shadow-md md:text-4xl lg:text-5xl"
            >
              {titleMain}
              {
                titleSub && (
                  <>
                    <br />
                    <span class="font-sans text-2xl font-bold tracking-normal opacity-90 md:text-3xl">
                      {titleSub}
                    </span>
                  </>
                )
              }
            </h1>
          </div>
        </div>

        <!-- Screenshots Thumbnails -->
        <div class="mt-4 grid grid-cols-4 gap-3">
          {
            galleryImages.map((src, index) => (
              <button
                type="button"
                class={`gallery-thumb-btn aspect-video cursor-pointer overflow-hidden rounded-lg border transition-colors ${
                  index === 0
                    ? "border-nexus-accent shadow-neon-peach"
                    : "border-nexus-surface hover:border-nexus-accent"
                }`}
                data-src={src.replace("&w=400", "&w=1200")}
                aria-label={`View image ${index + 1} of ${title}`}
              >
                <Image
                  src={src}
                  alt={`${title} - screenshot ${index + 1}`}
                  width={320}
                  height={180}
                  loading="lazy"
                  class={`h-full w-full object-cover transition-all duration-500 hover:scale-110 ${
                    index === 0 ? "" : "opacity-70 hover:opacity-100"
                  }`}
                />
              </button>
            ))
          }
        </div>
      </div>

      <!-- RIGHT COLUMN: Details & Purchase -->
      <div class="flex flex-col gap-10 lg:col-span-7">
        <!-- Title Header & Price Block -->
        <div
          class="border-nexus-surface flex flex-col items-start justify-between gap-6 border-b pb-8 md:flex-row"
        >
          <h2
            class="font-display text-4xl leading-tight font-black text-white lg:max-w-md lg:text-5xl"
          >
            {title}
          </h2>

          <!-- Purchase Card -->
          <div
            class="bg-nexus-surface/50 border-nexus-surface w-full min-w-[280px] rounded-2xl border p-6 md:w-auto"
          >
            <div
              class="text-nexus-muted mb-2 text-sm font-bold tracking-widest uppercase"
            >
              BUY NOW
            </div>
            <div class="mb-6 flex items-center gap-3">
              <span class="text-lg text-white">Price:</span>
              <PriceDisplay
                price={price}
                discountPercent={discountPercent}
                size="lg"
              />
              {
                discountPercent && (
                  <span class="bg-nexus-primary/20 border-nexus-primary text-nexus-primary rounded border px-2 py-0.5 text-xs font-bold">
                    -{discountPercent}%
                  </span>
                )
              }
            </div>

            <div class="flex flex-col gap-3">
              <button
                id="btn-add-cart"
                data-slug={game.id}
                data-title={title}
                data-price={String(unitPrice)}
                data-image={image}
                class="bg-nexus-primary text-nexus-background shadow-neon-lime w-full rounded-lg px-6 py-4 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white disabled:cursor-not-allowed disabled:opacity-50"
              >
                <span>ADD TO CART</span>
              </button>
              <button
                id="btn-wishlist"
                data-slug={game.id}
                data-title={title}
                data-price={String(unitPrice)}
                data-image={image}
                class="border-nexus-accent text-nexus-accent hover:bg-nexus-accent hover:text-nexus-background block w-full rounded-lg border bg-transparent px-6 py-4 text-center text-sm font-bold tracking-widest uppercase shadow-[0_0_10px_rgba(246,190,154,0.2)] transition-all duration-300 disabled:cursor-not-allowed disabled:opacity-50"
              >
                <span>WISHLIST</span>
              </button>
            </div>
          </div>
        </div>

        <!-- GAME INFO SECTION -->
        <div class="space-y-8">
          <h3
            class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
          >
            GAME INFO
          </h3>

          <!-- 1. Description -->
          <div>
            <div class="mb-4 flex items-center justify-between">
              <h4 class="text-sm font-bold tracking-widest text-white">
                1. DESCRIPTION
              </h4>
              <span
                class="bg-nexus-accent/20 border-nexus-accent text-nexus-accent rounded border px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase shadow-[0_0_5px_rgba(246,190,154,0.3)]"
                >LIMITED</span
              >
            </div>
            <p class="text-nexus-muted text-[15px] leading-relaxed">
              {description}
            </p>
          </div>

          <!-- 2. Genre Tags -->
          <div>
            <h4 class="mb-4 text-sm font-bold tracking-widest text-white">
              2. GENRE TAGS
            </h4>
            <div class="flex flex-wrap gap-2">
              {
                genres.map((tag, index) => (
                  <span
                    class={`rounded-full border px-4 py-1.5 text-xs font-bold tracking-wider uppercase ${
                      index === 0
                        ? "bg-nexus-accent/20 border-nexus-accent text-nexus-accent shadow-[0_0_8px_rgba(246,190,154,0.3)]"
                        : index === 1
                          ? "bg-nexus-teal border-nexus-teal shadow-neon-teal text-white"
                          : "border-nexus-surface text-nexus-muted bg-transparent transition-colors hover:border-white hover:text-white"
                    }`}
                  >
                    {tag.replace("-", " ")}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- 3. Details Grid -->
          <div>
            <h4 class="mb-4 text-sm font-bold tracking-widest text-white">
              3. DETAILS
            </h4>
            <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
              {
                [
                  { label: "DEVELOPER:", value: developer },
                  { label: "RELEASE DATE:", value: releaseDate },
                  { label: "PLATFORMS:", value: platforms.join(", ") },
                  { label: "RATING:", value: rating },
                ].map((detail) => (
                  <div class="bg-nexus-surface/30 border-nexus-surface rounded-xl border p-4">
                    <span class="text-nexus-muted mb-1 block text-[10px] font-bold tracking-widest">
                      {detail.label}
                    </span>
                    <span class="text-sm font-medium text-white">
                      {detail.value}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- System Req, Achievements, Reviews -->
          <div
            class="border-nexus-surface grid grid-cols-1 gap-6 border-t pt-4 md:grid-cols-3"
          >
            <!-- System Req -->
            <div class="col-span-1 md:col-span-2">
              <div class="mb-4 flex items-center justify-between">
                <h4
                  class="text-sm font-bold tracking-widest text-white uppercase"
                >
                  SYSTEM REQUIREMENTS (PC)
                </h4>
                <Icon name="chevron-down" size={16} class="text-nexus-muted" />
              </div>
              <div class="flex gap-8">
                <div>
                  <span
                    class="text-nexus-muted mb-1 block text-[10px] font-bold tracking-widest"
                    >MINIMUM</span
                  >
                  <span class="mb-1 block text-lg font-bold text-white"
                    >{systemReq.min}</span
                  >
                  <span class="text-nexus-muted text-xs">Required Space</span>
                </div>
                <div class="border-nexus-surface border-l pl-8">
                  <span
                    class="text-nexus-muted mb-1 block text-[10px] font-bold tracking-widest"
                    >RECOMMENDED</span
                  >
                  <span class="mb-1 block text-lg font-bold text-white"
                    >{systemReq.rec}</span
                  >
                  <span class="text-nexus-muted text-xs">Required Space</span>
                </div>
              </div>
            </div>

            <!-- Achievements & Reviews -->
            <div class="flex gap-4">
              <div class="flex flex-1 flex-col justify-between">
                <h4
                  class="mb-4 text-sm font-bold tracking-widest text-white uppercase"
                >
                  ACHIEVEMENTS
                </h4>
                <div
                  class="border-nexus-accent/40 bg-nexus-accent/5 hover:shadow-neon-peach flex flex-grow cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border p-4 transition-shadow"
                >
                  <Icon
                    name="trophy"
                    size={28}
                    class="text-nexus-accent drop-shadow-[0_0_5px_rgba(246,190,154,0.8)]"
                  />
                  <span class="text-nexus-accent text-xs font-bold"
                    >52 / 60</span
                  >
                </div>
              </div>
              <div class="flex flex-1 flex-col justify-between">
                <h4
                  class="mb-4 text-center text-sm font-bold tracking-widest text-white uppercase"
                >
                  REVIEWS
                </h4>
                <div
                  class="border-nexus-surface bg-nexus-surface/20 group hover:border-nexus-accent relative flex flex-grow cursor-pointer items-center justify-center overflow-hidden rounded-xl border p-4 transition-colors"
                >
                  <div
                    class="from-nexus-accent/20 absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t to-transparent"
                  >
                  </div>
                  <div
                    class="text-nexus-accent relative z-10 flex gap-1"
                    role="img"
                    aria-label="4 de 5 estrellas"
                  >
                    {
                      [1, 2, 3, 4, 5].map((star) => (
                        <Icon
                          name="star"
                          size={16}
                          filled
                          class={star === 5 ? "opacity-50" : ""}
                        />
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Toast />
</Layout>

<script>
  import { addToCart, toggleWishlist, isInWishlist } from "../../utils/store";

  // Galería dinámica, notificaciones toast y acciones de compra
  // --- 1. Galería de imágenes ---
  const mainArtwork = document.getElementById(
    "main-artwork",
  ) as HTMLImageElement | null;
  const thumbButtons =
    document.querySelectorAll<HTMLButtonElement>(".gallery-thumb-btn");

  // Clases de estado de las miniaturas (strings completos para Tailwind)
  const ACTIVE_BTN = ["border-nexus-accent", "shadow-neon-peach"];
  const INACTIVE_BTN = ["border-nexus-surface"];

  if (mainArtwork && thumbButtons.length > 0) {
    thumbButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const newSrc = button.dataset.src;
        if (!newSrc) return;

        mainArtwork.style.opacity = "0";
        setTimeout(() => {
          mainArtwork.src = newSrc;
          mainArtwork.style.opacity = "1";
        }, 150);

        thumbButtons.forEach((other) => {
          const img = other.querySelector("img");
          const isActive = other === button;
          other.classList.toggle(ACTIVE_BTN[0], isActive);
          other.classList.toggle(ACTIVE_BTN[1], isActive);
          other.classList.toggle(INACTIVE_BTN[0], !isActive);
          img?.classList.toggle("opacity-70", !isActive);
        });
      });
    });
  }

  // --- 2. Toast Notification ---
  // (las funciones del store se importan arriba)
  type ToastVariant = "primary" | "accent";

  const toast = document.getElementById("toast-notification");
  const toastTitle = document.getElementById("toast-title");
  const toastMessage = document.getElementById("toast-message");
  let hideTimeout: ReturnType<typeof setTimeout> | undefined;

  const showToast = (title: string, message: string, variant: ToastVariant) => {
    if (!toast || !toastTitle || !toastMessage) return;

    toastTitle.innerText = title;
    toastMessage.innerText = message;
    toast.dataset.variant = variant;
    toast.classList.remove("translate-y-20", "opacity-0");

    clearTimeout(hideTimeout);
    hideTimeout = setTimeout(() => {
      toast.classList.add("translate-y-20", "opacity-0");
    }, 3000);
  };

  // --- 3. Carrito y wishlist reales (localStorage) ---
  const itemFromButton = (button: HTMLButtonElement) => ({
    slug: button.dataset.slug ?? "",
    title: button.dataset.title ?? "",
    price: Number(button.dataset.price ?? 0),
    image: button.dataset.image ?? "",
  });

  // Pequeño delay simulado para dar feedback de "procesando"
  const bindAction = (
    buttonId: string,
    loadingText: string,
    delay: number,
    onDone: (button: HTMLButtonElement) => void,
  ) => {
    const button = document.getElementById(
      buttonId,
    ) as HTMLButtonElement | null;
    if (!button) return;

    button.addEventListener("click", () => {
      const span = button.querySelector("span");
      const originalText = span?.innerText ?? "";

      button.disabled = true;
      if (span) span.innerText = loadingText;

      setTimeout(() => {
        onDone(button);
        button.disabled = false;
        if (span && span.innerText === loadingText) {
          span.innerText = originalText;
        }
      }, delay);
    });
  };

  bindAction("btn-add-cart", "ADDING...", 600, (button) => {
    const item = itemFromButton(button);
    addToCart(item);
    showToast(
      `${item.title} added to cart`,
      "Check your cart to checkout.",
      "primary",
    );
  });

  const wishlistButton = document.getElementById(
    "btn-wishlist",
  ) as HTMLButtonElement | null;

  const syncWishlistLabel = () => {
    const span = wishlistButton?.querySelector("span");
    const slug = wishlistButton?.dataset.slug ?? "";
    if (span) span.innerText = isInWishlist(slug) ? "SAVED ✓" : "WISHLIST";
  };

  syncWishlistLabel();

  bindAction("btn-wishlist", "SAVING...", 400, (button) => {
    const item = itemFromButton(button);
    const saved = toggleWishlist(item);
    showToast(
      saved ? "Saved to wishlist" : "Removed from wishlist",
      saved ? "We'll notify you about deals." : `${item.title} was removed.`,
      "accent",
    );
    syncWishlistLabel();
  });
</script>
