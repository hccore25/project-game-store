---
import Layout from "../layouts/Layout.astro";

const sections = [
  { id: "acceptance", title: "1. Acceptance of Terms" },
  { id: "products", title: "2. Digital Products" },
  { id: "payments", title: "3. Purchases & Payments" },
  { id: "refunds", title: "4. Refund Policy" },
  { id: "conduct", title: "5. Prohibited Conduct" },
  { id: "ip", title: "6. Intellectual Property" },
  { id: "disclaimer", title: "7. Disclaimer of Warranties" },
  { id: "liability", title: "8. Limitation of Liability" },
  { id: "changes", title: "9. Changes to These Terms" },
  { id: "contact", title: "10. Contact" },
];
---

<Layout
  title="Terms of Service"
  description="Read the NEXUSSTORE Terms of Service before using our platform."
>
  <div class="container mx-auto px-4 py-12 lg:px-6">
    <!-- Page Header -->
    <div class="border-nexus-surface mb-10 border-b pb-8">
      <p
        class="text-nexus-primary mb-2 text-xs font-bold tracking-widest uppercase"
      >
        Legal
      </p>
      <h1
        class="font-display text-4xl font-black text-white uppercase md:text-5xl"
      >
        Terms of Service
      </h1>
      <p class="text-nexus-muted mt-3 text-sm">
        Last updated: <time datetime="2025-06-01">June 1, 2025</time>
      </p>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[220px_1fr]">
      <!-- Sidebar TOC -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24 space-y-0.5">
          <p
            class="text-nexus-muted mb-3 text-xs font-bold tracking-widest uppercase"
          >
            Contents
          </p>
          {
            sections.map((s) => (
              <a
                href={`#${s.id}`}
                class="hover:text-nexus-primary text-nexus-muted block py-1.5 text-xs transition-colors"
              >
                {s.title}
              </a>
            ))
          }
        </nav>
      </aside>

      <!-- Main Content -->
      <article class="space-y-10 text-sm leading-relaxed">
        <p class="text-nexus-muted">
          Welcome to NEXUSSTORE. By accessing or using our platform you agree to
          be bound by these Terms of Service. If you do not agree, please do not
          use the service.
        </p>

        <section id="acceptance">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            1. Acceptance of Terms
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              By creating an order on NEXUSSTORE you confirm that you are at
              least 13 years of age (or the minimum digital consent age in your
              country, whichever is higher) and that you accept these Terms in
              full.
            </p>
            <p>
              These Terms form a legally binding agreement between you and
              NEXUSSTORE. We reserve the right to update them at any time;
              continued use of the service after changes constitutes acceptance.
            </p>
          </div>
        </section>

        <section id="products">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            2. Digital Products
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              All products sold on NEXUSSTORE are digital goods — specifically,
              software license keys for video games. No physical goods are
              shipped.
            </p>
            <p>
              Each key grants you a non-exclusive, non-transferable license to
              access the associated game title according to the terms set by the
              respective game publisher. NEXUSSTORE does not own the games and
              is not responsible for publisher-side changes to availability or
              features.
            </p>
            <p>
              System requirements, platform compatibility, and content ratings
              are listed on each product page. It is your responsibility to
              verify compatibility before purchasing.
            </p>
          </div>
        </section>

        <section id="payments">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            3. Purchases & Payments
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              All prices are displayed in US dollars (USD) and are inclusive of
              applicable taxes unless stated otherwise. We accept major credit
              and debit cards. By submitting payment information you authorize
              us to charge the full amount of your order.
            </p>
            <p>
              Promotions and discounts are applied automatically at checkout and
              cannot be combined unless explicitly stated. We reserve the right
              to correct pricing errors and to cancel orders affected by
              technical pricing issues.
            </p>
          </div>
        </section>

        <section id="refunds">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            4. Refund Policy
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              Refunds may be requested within <strong class="text-white"
                >14 days</strong
              > of purchase, provided the game key has <strong class="text-white"
                >not been redeemed</strong
              > on the target platform. Once a key is activated it is considered
              consumed and cannot be refunded.
            </p>
            <p>
              To request a refund, contact our support team through the Contact
              page and include your order ID. Approved refunds are processed
              within 5–10 business days to your original payment method.
            </p>
          </div>
        </section>

        <section id="conduct">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            5. Prohibited Conduct
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>You agree not to:</p>
            <ul class="ml-4 list-disc space-y-1.5">
              <li>
                Resell, redistribute, or commercially exploit any keys purchased
                on NEXUSSTORE without prior written authorization.
              </li>
              <li>
                Use automated tools, bots, or scrapers to access or interact
                with the platform.
              </li>
              <li>
                Attempt to circumvent security measures, pricing systems, or
                fraud prevention mechanisms.
              </li>
              <li>
                Submit false or fraudulent orders, chargebacks, or refund
                requests.
              </li>
              <li>
                Post unlawful, defamatory, or misleading content through any
                part of the platform.
              </li>
            </ul>
          </div>
        </section>

        <section id="ip">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            6. Intellectual Property
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              The NEXUSSTORE name, logo, design, and all original content on
              this website are the intellectual property of NEXUSSTORE and may
              not be reproduced without permission.
            </p>
            <p>
              All game titles, artwork, and trademarks belong to their
              respective publishers and developers. Their presence on our
              platform does not imply endorsement.
            </p>
          </div>
        </section>

        <section id="disclaimer">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            7. Disclaimer of Warranties
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              NEXUSSTORE is provided "as is" and "as available." We make no
              warranties — express or implied — regarding merchantability,
              fitness for a particular purpose, or uninterrupted availability of
              the service.
            </p>
          </div>
        </section>

        <section id="liability">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            8. Limitation of Liability
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              To the maximum extent permitted by applicable law, NEXUSSTORE and
              its affiliates will not be liable for indirect, incidental,
              special, or consequential damages arising from your use of the
              service. Our total liability for any claim will not exceed the
              amount you paid for the order in question.
            </p>
          </div>
        </section>

        <section id="changes">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            9. Changes to These Terms
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              We may update these Terms periodically. Material changes will be
              announced via a notice on our homepage or by email where
              applicable. Continued use of the service after the effective date
              of any update constitutes your acceptance of the revised Terms.
            </p>
          </div>
        </section>

        <section id="contact">
          <h2
            class="font-display mb-4 text-lg font-bold text-white uppercase tracking-wide"
          >
            10. Contact
          </h2>
          <div class="text-nexus-muted space-y-3">
            <p>
              Questions about these Terms? Reach out at
              <a
                href="mailto:legal@nexusgames.co"
                class="text-nexus-primary hover:underline">legal@nexusgames.co</a
              > or through our <a
                href="/contact"
                class="text-nexus-primary hover:underline">Contact page</a
              >.
            </p>
          </div>
        </section>
      </article>
    </div>
  </div>
</Layout>
