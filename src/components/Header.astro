---
import Icon from "./Icon.astro";

const navLinks = [
  { href: "/", label: "EXPLORE" },
  { href: "/#store", label: "STORE" },
  { href: "/#genres", label: "GENRES" },
  { href: "/#community", label: "COMMUNITY" },
  { href: "/#deals", label: "DEALS" },
];
---

<header
  class="border-nexus-surface bg-nexus-background sticky top-0 z-50 border-b"
>
  <div
    class="container mx-auto flex h-20 items-center justify-between px-4 lg:px-6"
  >
    <!-- Logo -->
    <a href="/" class="flex flex-col items-start gap-0.5 leading-none">
      <span
        class="font-display text-2xl font-black tracking-widest text-white uppercase"
        >NEXUS</span
      >
      <span
        class="text-nexus-primary text-[0.6rem] font-bold tracking-[0.4em] uppercase"
        >GAMES</span
      >
    </a>

    <!-- Desktop Nav -->
    <nav
      class="text-nexus-muted hidden gap-8 text-xs font-semibold tracking-widest lg:flex"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="uppercase transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Icons -->
    <div class="flex items-center gap-5">
      <button
        class="text-nexus-muted transition-colors hover:text-white"
        aria-label="Buscar"
      >
        <Icon name="search" size={20} />
      </button>

      <button
        class="text-nexus-muted hidden transition-colors hover:text-white sm:block"
        aria-label="Cuenta de usuario"
      >
        <Icon name="user-circle" size={20} />
      </button>

      <button
        class="text-nexus-accent relative transition-colors hover:text-white"
        aria-label="Carrito"
      >
        <Icon name="cart" size={20} />
        <span
          class="bg-nexus-primary text-nexus-background absolute -top-2 -right-2 flex h-4 w-4 items-center justify-center rounded-full text-[10px] font-bold"
          >2</span
        >
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        class="text-nexus-muted transition-colors hover:text-white lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-btn"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu (oculto por defecto) -->
<div
  id="mobile-menu"
  class="bg-nexus-background fixed inset-0 z-[60] flex translate-x-full transform flex-col transition-transform duration-300 ease-in-out"
>
  <div
    class="border-nexus-surface bg-nexus-background flex items-center justify-between border-b px-6 py-6"
  >
    <div class="flex flex-col items-start gap-0.5 leading-none">
      <span
        class="font-display text-xl font-black tracking-widest text-white uppercase"
        >NEXUS</span
      >
      <span
        class="text-nexus-primary text-[0.5rem] font-bold tracking-[0.4em] uppercase"
        >GAMES</span
      >
    </div>
    <button
      id="close-mobile-menu"
      class="text-nexus-primary transition-colors hover:text-white"
      aria-label="Cerrar menú"
    >
      <Icon name="close" size={28} />
    </button>
  </div>

  <div class="flex flex-grow flex-col justify-between overflow-y-auto p-6">
    <!-- Vertical Nav Links -->
    <nav
      class="border-nexus-primary mt-4 flex flex-col space-y-8 border-l-[3px] pl-6"
    >
      {
        navLinks.map((link, index) => (
          <a
            href={link.href}
            class={
              index === 0
                ? "font-display hover:text-nexus-accent text-3xl font-bold tracking-wider text-white uppercase transition-colors"
                : "font-display text-nexus-muted text-3xl font-bold tracking-wider uppercase transition-colors hover:text-white"
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- User Section Mobile -->
    <div class="border-nexus-accent mt-12 mb-8 border-l-[3px] pl-6">
      <h4
        class="text-nexus-accent mb-4 text-sm font-bold tracking-widest uppercase"
      >
        YOUR ACCOUNT
      </h4>
      <div class="mb-6 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img
            src="https://ui-avatars.com/api/?name=Aether+Striker&background=004643&color=f6be9a"
            alt="AETHER_STRIKER"
            class="border-nexus-primary h-12 w-12 rounded-full border-2"
          />
          <div class="flex flex-col">
            <span class="leading-tight font-bold text-white uppercase"
              >AETHER_STRIKER</span
            >
            <span class="text-nexus-muted flex items-center gap-2 text-sm"
              >Level 42 <span
                class="bg-nexus-primary h-2 w-2 rounded-full drop-shadow-[0_0_5px_rgba(159,204,46,0.8)]"
              ></span> ONLINE</span
            >
          </div>
        </div>
      </div>

      <!-- Mobile Account Links -->
      <div
        class="text-nexus-muted grid grid-cols-3 gap-2 text-center text-xs font-bold tracking-wider"
      >
        <a
          href="#"
          class="flex flex-col items-center gap-2 transition-colors hover:text-white"
        >
          <Icon name="bell" size={24} class="text-nexus-accent" />
          NOTIFICATIONS
        </a>
        <a
          href="#"
          class="flex flex-col items-center gap-2 transition-colors hover:text-white"
        >
          <Icon name="settings" size={24} class="text-nexus-primary" />
          SETTINGS
        </a>
        <a
          href="#"
          class="flex flex-col items-center gap-2 transition-colors hover:text-white"
        >
          <Icon name="logout" size={24} class="text-red-500" />
          LOGOUT
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Manejo del menú móvil
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const closeMobileBtn = document.getElementById("close-mobile-menu");
  const mobileMenu = document.getElementById("mobile-menu");

  if (mobileMenuBtn && closeMobileBtn && mobileMenu) {
    const openMenu = () => {
      mobileMenu.classList.remove("translate-x-full");
      mobileMenuBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden"; // Prevenir scroll
    };

    const closeMenu = () => {
      mobileMenu.classList.add("translate-x-full");
      mobileMenuBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = ""; // Restaurar scroll
    };

    mobileMenuBtn.addEventListener("click", openMenu);
    closeMobileBtn.addEventListener("click", closeMenu);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    // Cerrar al navegar a un enlace del menú
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }
</script>
