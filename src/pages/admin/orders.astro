---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listOrders } from "../../lib/orders";
import { formatPrice } from "../../utils/format";

export const prerender = false;

const orders = await listOrders();
---

<AdminLayout title="Pedidos">
  <div class="mb-8">
    <h1
      class="font-display text-2xl font-black tracking-widest text-white uppercase"
    >
      Pedidos
    </h1>
    <p class="text-nexus-muted mt-1 text-sm">
      {orders.length}
      {orders.length === 1 ? "pedido" : "pedidos"} · checkout de invitado, sin pago
      real
    </p>
  </div>

  {
    orders.length === 0 ? (
      <div class="border-nexus-surface rounded-2xl border border-dashed p-16 text-center">
        <p class="text-nexus-muted text-sm">Todavía no hay pedidos.</p>
      </div>
    ) : (
      <div class="border-nexus-surface overflow-x-auto rounded-2xl border">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-nexus-surface text-nexus-muted border-b text-xs tracking-widest uppercase">
            <tr>
              <th class="px-4 py-3 font-bold">Código</th>
              <th class="px-4 py-3 font-bold">Cliente</th>
              <th class="px-4 py-3 font-bold">Ítems</th>
              <th class="px-4 py-3 font-bold">Total</th>
              <th class="px-4 py-3 font-bold">Fecha</th>
              <th class="px-4 py-3" />
            </tr>
          </thead>
          <tbody>
            {orders.map((order) => (
              <tr class="border-nexus-surface/60 border-b last:border-0">
                <td class="text-nexus-accent px-4 py-3 font-mono text-xs">
                  {order.id}
                </td>
                <td class="px-4 py-3">
                  <p class="text-white">{order.customerName}</p>
                  <p class="text-nexus-muted text-xs">{order.email}</p>
                </td>
                <td class="text-nexus-muted px-4 py-3">{order.itemCount}</td>
                <td class="px-4 py-3 font-bold text-white">
                  {formatPrice(order.total)}
                </td>
                <td class="text-nexus-muted px-4 py-3 text-xs">
                  {order.createdAt.toLocaleString("es", {
                    dateStyle: "medium",
                    timeStyle: "short",
                  })}
                </td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/order-confirmation/${order.id}`}
                    class="border-nexus-surface text-nexus-muted rounded-lg border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors hover:border-white hover:text-white"
                  >
                    Ver
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
