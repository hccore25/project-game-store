---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listGames } from "../../lib/games";
import { formatPrice, finalPrice } from "../../utils/format";

export const prerender = false;

const games = await listGames();

const created = Astro.url.searchParams.get("created");
const updated = Astro.url.searchParams.get("updated");
const deleted = Astro.url.searchParams.get("deleted");
const flash = created
  ? `Juego «${created}» creado.`
  : updated
    ? `Juego «${updated}» actualizado.`
    : deleted
      ? `Juego «${deleted}» eliminado.`
      : null;
---

<AdminLayout title="Catálogo">
  <div class="mb-8 flex items-end justify-between gap-4">
    <div>
      <h1
        class="font-display text-2xl font-black tracking-widest text-white uppercase"
      >
        Catálogo
      </h1>
      <p class="text-nexus-muted mt-1 text-sm">
        {games.length}
        {games.length === 1 ? "juego" : "juegos"} · cambios visibles al instante en
        la tienda
      </p>
    </div>
    <a
      href="/admin/games/new"
      class="bg-nexus-primary text-nexus-background shadow-neon-lime shrink-0 rounded-lg px-5 py-3 text-xs font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white"
    >
      + Nuevo juego
    </a>
  </div>

  {
    flash && (
      <p class="border-nexus-primary bg-nexus-primary/10 text-nexus-primary mb-6 rounded-lg border px-4 py-3 text-sm">
        {flash}
      </p>
    )
  }

  {
    games.length === 0 ? (
      <div class="border-nexus-surface rounded-2xl border border-dashed p-16 text-center">
        <p class="text-nexus-muted text-sm">
          No hay juegos todavía. Creá el primero o corré <code>pnpm db:seed</code>
          .
        </p>
      </div>
    ) : (
      <div class="border-nexus-surface overflow-x-auto rounded-2xl border">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-nexus-surface text-nexus-muted border-b text-xs tracking-widest uppercase">
            <tr>
              <th class="px-4 py-3 font-bold">Juego</th>
              <th class="px-4 py-3 font-bold">Precio</th>
              <th class="px-4 py-3 font-bold">Géneros</th>
              <th class="px-4 py-3 font-bold">Flags</th>
              <th class="px-4 py-3" />
            </tr>
          </thead>
          <tbody>
            {games.map((game) => (
              <tr class="border-nexus-surface/60 border-b last:border-0">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <img
                      src={game.data.image}
                      alt=""
                      width="40"
                      height="53"
                      loading="lazy"
                      class="h-[52px] w-10 shrink-0 rounded object-cover"
                    />
                    <div class="min-w-0">
                      <p class="truncate font-bold text-white">
                        {game.data.title}
                      </p>
                      <p class="text-nexus-muted truncate text-xs">
                        {game.id}
                      </p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  {game.data.discountPercent ? (
                    <span>
                      <span class="text-nexus-primary font-bold">
                        {formatPrice(
                          finalPrice(
                            game.data.price,
                            game.data.discountPercent,
                          ),
                        )}
                      </span>
                      <span class="text-nexus-muted ml-1 text-xs line-through">
                        {formatPrice(game.data.price)}
                      </span>
                    </span>
                  ) : (
                    <span class="text-white">
                      {formatPrice(game.data.price)}
                    </span>
                  )}
                </td>
                <td class="text-nexus-muted px-4 py-3 text-xs">
                  {game.data.genres.join(", ")}
                </td>
                <td class="px-4 py-3 text-xs">
                  <span class="flex flex-wrap gap-1">
                    {game.data.featured && (
                      <span class="bg-nexus-teal rounded px-1.5 py-0.5 text-white">
                        featured
                      </span>
                    )}
                    {game.data.isNew && (
                      <span class="bg-nexus-teal rounded px-1.5 py-0.5 text-white">
                        new
                      </span>
                    )}
                    {game.data.preorder && (
                      <span class="bg-nexus-teal rounded px-1.5 py-0.5 text-white">
                        preorder
                      </span>
                    )}
                    {game.data.tag && (
                      <span class="bg-nexus-accent/20 text-nexus-accent rounded px-1.5 py-0.5">
                        {game.data.tag}
                      </span>
                    )}
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/admin/games/${game.id}`}
                      class="border-nexus-surface text-nexus-muted rounded-lg border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors hover:border-white hover:text-white"
                    >
                      Editar
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/games/${game.id}/delete`}
                      data-confirm={`¿Eliminar «${game.data.title}»? No se puede deshacer.`}
                    >
                      <button
                        type="submit"
                        class="border-nexus-surface text-nexus-muted rounded-lg border px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors hover:border-red-400 hover:text-red-400"
                      >
                        Borrar
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<script>
  // Confirmación antes de borrar (mejora progresiva).
  document
    .querySelectorAll<HTMLFormElement>("form[data-confirm]")
    .forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (!window.confirm(form.dataset.confirm ?? "¿Confirmás?")) {
          event.preventDefault();
        }
      });
    });
</script>
