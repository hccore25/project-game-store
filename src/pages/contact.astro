---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Contact Us"
  description="Get in touch with the NEXUSSTORE support team for help with orders, payments, or any other question."
>
  <div class="container mx-auto px-4 py-12 lg:px-6">
    <!-- Header -->
    <div class="mb-12">
      <p
        class="text-nexus-primary mb-3 text-xs font-bold tracking-widest uppercase"
      >
        Support
      </p>
      <h1
        class="font-display text-4xl font-black text-white uppercase md:text-5xl"
      >
        Contact Us
      </h1>
      <p class="text-nexus-muted mt-3 max-w-lg text-base">
        Fill in the form below and we'll get back to you within 24–48 hours.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_340px]">
      <!-- Contact Form -->
      <div class="bg-nexus-surface/30 border-nexus-surface rounded-2xl border p-8">
        <!-- Success state (hidden by default) -->
        <div
          id="contact-success"
          class="hidden flex-col items-center gap-4 py-10 text-center"
        >
          <div class="bg-nexus-primary/10 rounded-full p-4">
            <Icon name="check" size={32} class="text-nexus-primary" />
          </div>
          <p class="font-display text-xl font-bold text-white">Message sent!</p>
          <p class="text-nexus-muted max-w-xs text-sm">
            Thanks for reaching out. We'll get back to you within 24–48 hours.
          </p>
          <a
            href="/"
            class="text-nexus-primary mt-2 text-sm font-bold hover:underline"
            >Back to store</a
          >
        </div>

        <!-- Form -->
        <form id="contact-form" novalidate class="space-y-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label
                for="contact-name"
                class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
                >Full Name</label
              >
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="John Doe"
                class="bg-nexus-surface border-nexus-surface text-nexus-text placeholder:text-nexus-muted/50 focus:border-nexus-primary w-full rounded-lg border px-4 py-3 text-sm outline-none transition-colors"
              />
              <p
                class="text-nexus-accent mt-1 hidden text-xs"
                data-error="name"
              >
                Please enter your name.
              </p>
            </div>

            <div>
              <label
                for="contact-email"
                class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
                >Email</label
              >
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="bg-nexus-surface border-nexus-surface text-nexus-text placeholder:text-nexus-muted/50 focus:border-nexus-primary w-full rounded-lg border px-4 py-3 text-sm outline-none transition-colors"
              />
              <p
                class="text-nexus-accent mt-1 hidden text-xs"
                data-error="email"
              >
                Please enter a valid email address.
              </p>
            </div>
          </div>

          <div>
            <label
              for="contact-subject"
              class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
              >Subject</label
            >
            <select
              id="contact-subject"
              name="subject"
              required
              class="bg-nexus-surface border-nexus-surface text-nexus-text focus:border-nexus-primary w-full rounded-lg border px-4 py-3 text-sm outline-none transition-colors"
            >
              <option value="" disabled selected>Select a topic…</option>
              <option value="general">General Question</option>
              <option value="order">Order Issue</option>
              <option value="technical">Technical Problem</option>
              <option value="refund">Refund Request</option>
              <option value="other">Other</option>
            </select>
            <p
              class="text-nexus-accent mt-1 hidden text-xs"
              data-error="subject"
            >
              Please select a subject.
            </p>
          </div>

          <div>
            <label
              for="contact-message"
              class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
              >Message</label
            >
            <textarea
              id="contact-message"
              name="message"
              required
              rows={6}
              placeholder="Describe your issue or question in detail…"
              class="bg-nexus-surface border-nexus-surface text-nexus-text placeholder:text-nexus-muted/50 focus:border-nexus-primary w-full resize-none rounded-lg border px-4 py-3 text-sm outline-none transition-colors"
            ></textarea>
            <p
              class="text-nexus-accent mt-1 hidden text-xs"
              data-error="message"
            >
              Please enter your message (at least 20 characters).
            </p>
          </div>

          <button
            id="contact-submit"
            type="submit"
            class="bg-nexus-primary text-nexus-background shadow-neon-lime flex w-full items-center justify-center gap-2 rounded-lg px-8 py-3.5 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span id="submit-label">SEND MESSAGE</span>
            <span id="submit-spinner" class="hidden">
              <svg
                class="h-4 w-4 animate-spin"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
              </svg>
            </span>
          </button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <div class="bg-nexus-surface/30 border-nexus-surface rounded-2xl border p-6">
          <div class="mb-3 flex items-center gap-3">
            <div class="bg-nexus-teal/30 text-nexus-primary rounded-lg p-2">
              <Icon name="mail" size={18} />
            </div>
            <h2 class="font-display text-sm font-bold text-white uppercase">
              Email
            </h2>
          </div>
          <p class="text-nexus-muted text-sm">support@nexusgames.co</p>
          <p class="text-nexus-muted mt-1 text-xs">
            We reply within 24–48 hours on business days.
          </p>
        </div>

        <div class="bg-nexus-surface/30 border-nexus-surface rounded-2xl border p-6">
          <div class="mb-3 flex items-center gap-3">
            <div class="bg-nexus-teal/30 text-nexus-primary rounded-lg p-2">
              <Icon name="discord" size={18} />
            </div>
            <h2 class="font-display text-sm font-bold text-white uppercase">
              Discord
            </h2>
          </div>
          <p class="text-nexus-muted text-sm">Join our community server</p>
          <p class="text-nexus-muted mt-1 text-xs">
            Get real-time help from staff and fellow gamers.
          </p>
        </div>

        <div class="bg-nexus-surface/30 border-nexus-surface rounded-2xl border p-6">
          <div class="mb-3 flex items-center gap-3">
            <div class="bg-nexus-teal/30 text-nexus-primary rounded-lg p-2">
              <Icon name="clock" size={18} />
            </div>
            <h2 class="font-display text-sm font-bold text-white uppercase">
              Support Hours
            </h2>
          </div>
          <dl class="text-nexus-muted space-y-1 text-sm">
            <div class="flex justify-between">
              <dt>Mon – Fri</dt>
              <dd class="text-white">9 AM – 8 PM EST</dd>
            </div>
            <div class="flex justify-between">
              <dt>Sat – Sun</dt>
              <dd class="text-white">11 AM – 6 PM EST</dd>
            </div>
          </dl>
        </div>

        <div class="bg-nexus-surface/30 border-nexus-surface rounded-2xl border p-6">
          <p class="text-nexus-muted text-xs leading-relaxed">
            For faster resolution, include your <span class="text-white"
              >order ID</span
            > and a short description of the issue when contacting us.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successEl = document.getElementById("contact-success");
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const submitLabel = document.getElementById("submit-label");
  const submitSpinner = document.getElementById("submit-spinner");

  function showError(field: string, show: boolean) {
    const el = document.querySelector(`[data-error="${field}"]`);
    el?.classList.toggle("hidden", !show);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const name = (form.elements.namedItem("name") as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
    const subject = (form.elements.namedItem("subject") as HTMLSelectElement).value;
    const message = (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim();

    let valid = true;

    showError("name", !name);
    if (!name) valid = false;

    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    showError("email", !emailOk);
    if (!emailOk) valid = false;

    showError("subject", !subject);
    if (!subject) valid = false;

    showError("message", message.length < 20);
    if (message.length < 20) valid = false;

    if (!valid) return;

    if (submitBtn) submitBtn.disabled = true;
    submitLabel?.classList.add("hidden");
    submitSpinner?.classList.remove("hidden");

    await new Promise((r) => setTimeout(r, 1500));

    form.classList.add("hidden");
    if (successEl) successEl.classList.replace("hidden", "flex");
  });
</script>
