---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "@fontsource-variable/montserrat";
import "@fontsource-variable/nunito";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Imagen para Open Graph / Twitter Cards (absoluta o del catálogo). */
  image?: string;
  referrerPolicy?: string;
}

const {
  title,
  description = "Hernán Cubillos Store – a full-stack digital game storefront portfolio project.",
  image = "/images/games/chrono-break.webp",
  referrerPolicy,
} = Astro.props;

const fullTitle = `${title} | Hernán Cubillos Store`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {referrerPolicy && <meta name="referrer" content={referrerPolicy} />}

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hernán Cubillos Store" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body
    class="bg-nexus-background text-nexus-text selection:bg-nexus-primary selection:text-nexus-background flex min-h-screen flex-col font-sans"
  >
    <a
      href="#main-content"
      class="bg-nexus-primary text-nexus-background sr-only z-[100] rounded-lg px-4 py-2 text-sm font-bold focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
