---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const inputClass =
  "border-nexus-surface bg-nexus-surface/30 text-nexus-text placeholder:text-nexus-muted/60 focus:border-nexus-primary w-full rounded-lg border px-4 py-3 text-sm focus:outline-none";
---

<Layout title="Checkout" description="Complete your simulated purchase.">
  <div class="container mx-auto px-4 py-8 lg:px-6">
    <h1
      class="font-display mb-8 text-3xl font-black tracking-widest text-white uppercase"
    >
      CHECKOUT
    </h1>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
      <!-- Payment form -->
      <form id="checkout-form" class="space-y-6 lg:col-span-3" novalidate>
        <div
          class="bg-nexus-teal/20 border-nexus-teal text-nexus-accent flex items-center gap-3 rounded-xl border p-4 text-sm"
        >
          <Icon name="key" size={18} />
          <span>
            Demo store — no real payment is processed. Use test card
            <strong class="text-white">4242 4242 4242 4242</strong>.
          </span>
        </div>

        <div>
          <label
            for="field-name"
            class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
            >Full name</label
          >
          <input
            id="field-name"
            name="name"
            type="text"
            placeholder="Aether Striker"
            class={inputClass}
          />
          <p class="field-error text-nexus-accent mt-1 hidden text-xs">
            Enter your full name.
          </p>
        </div>

        <div>
          <label
            for="field-email"
            class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
            >Email (game keys will be "sent" here)</label
          >
          <input
            id="field-email"
            name="email"
            type="email"
            placeholder="player@nexus.gg"
            class={inputClass}
          />
          <p class="field-error text-nexus-accent mt-1 hidden text-xs">
            Enter a valid email address.
          </p>
        </div>

        <div>
          <label
            for="field-card"
            class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
            >Card number</label
          >
          <input
            id="field-card"
            name="card"
            inputmode="numeric"
            placeholder="4242 4242 4242 4242"
            class={inputClass}
          />
          <p class="field-error text-nexus-accent mt-1 hidden text-xs">
            Enter a 16-digit card number.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label
              for="field-expiry"
              class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
              >Expiry (MM/YY)</label
            >
            <input
              id="field-expiry"
              name="expiry"
              placeholder="12/28"
              class={inputClass}
            />
            <p class="field-error text-nexus-accent mt-1 hidden text-xs">
              Enter a valid future date.
            </p>
          </div>
          <div>
            <label
              for="field-cvc"
              class="text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase"
              >CVC</label
            >
            <input
              id="field-cvc"
              name="cvc"
              inputmode="numeric"
              placeholder="123"
              class={inputClass}
            />
            <p class="field-error text-nexus-accent mt-1 hidden text-xs">
              3 or 4 digits.
            </p>
          </div>
        </div>

        <button
          id="pay-button"
          type="submit"
          class="bg-nexus-primary text-nexus-background shadow-neon-lime w-full rounded-lg px-6 py-4 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="pay-label">PAY NOW</span>
        </button>
      </form>

      <!-- Order summary -->
      <aside
        class="bg-nexus-surface/30 border-nexus-surface h-fit rounded-2xl border p-6 lg:col-span-2"
      >
        <h2
          class="text-nexus-muted mb-6 text-sm font-bold tracking-widest uppercase"
        >
          ORDER SUMMARY
        </h2>
        <ul id="checkout-items" class="mb-6 space-y-3 text-sm"></ul>
        <div
          class="border-nexus-surface flex justify-between border-t pt-4 text-base"
        >
          <span class="font-bold text-white">Total</span>
          <span
            id="checkout-total"
            class="text-nexus-primary font-display font-black"></span>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import { getCart, cartTotal, placeOrder } from "../utils/store";
    import { formatPrice } from "../utils/format";

    const cart = getCart();

    // Sin carrito no hay checkout
    if (cart.length === 0) {
      window.location.replace("/cart");
    }

    // --- Resumen ---
    const itemsList = document.getElementById("checkout-items");
    const totalEl = document.getElementById("checkout-total");

    if (itemsList && totalEl) {
      for (const item of cart) {
        const li = document.createElement("li");
        li.className = "flex justify-between gap-4";

        const name = document.createElement("span");
        name.className = "text-nexus-muted truncate";
        name.textContent = `${item.title} × ${item.qty}`;

        const price = document.createElement("span");
        price.className = "shrink-0 font-bold text-white";
        price.textContent = formatPrice(item.price * item.qty);

        li.append(name, price);
        itemsList.append(li);
      }
      totalEl.textContent = formatPrice(cartTotal());

      const payLabel = document.getElementById("pay-label");
      if (payLabel) payLabel.textContent = `PAY ${formatPrice(cartTotal())}`;
    }

    // --- Validación y pago simulado ---
    const form = document.getElementById(
      "checkout-form",
    ) as HTMLFormElement | null;
    const payButton = document.getElementById(
      "pay-button",
    ) as HTMLButtonElement | null;

    const validators: Record<string, (value: string) => boolean> = {
      "field-name": (v) => v.trim().length >= 3,
      "field-email": (v) => /^\S+@\S+\.\S+$/.test(v.trim()),
      "field-card": (v) => /^\d{16}$/.test(v.replace(/\s/g, "")),
      "field-expiry": (v) => {
        const match = v.trim().match(/^(0[1-9]|1[0-2])\/(\d{2})$/);
        if (!match) return false;
        const expiry = new Date(2000 + Number(match[2]), Number(match[1]), 0);
        return expiry >= new Date();
      },
      "field-cvc": (v) => /^\d{3,4}$/.test(v.trim()),
    };

    const validateField = (id: string): boolean => {
      const input = document.getElementById(id) as HTMLInputElement | null;
      if (!input) return false;
      const valid = validators[id](input.value);
      input.classList.toggle("border-nexus-accent", !valid);
      input
        .closest("div")
        ?.querySelector(".field-error")
        ?.classList.toggle("hidden", valid);
      return valid;
    };

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const allValid = Object.keys(validators)
        .map(validateField)
        .every(Boolean);
      if (!allValid || !payButton) return;

      const label = document.getElementById("pay-label");
      payButton.disabled = true;
      if (label) label.textContent = "PROCESSING PAYMENT...";

      // Simula el procesamiento del pago y genera la orden con claves
      setTimeout(() => {
        placeOrder();
        window.location.href = "/order-confirmation";
      }, 1800);
    });
  </script>
</Layout>
