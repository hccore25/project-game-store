---
import "@fontsource-variable/montserrat";
import "@fontsource-variable/nunito";
import "../styles/global.css";

interface Props {
  title: string;
  /** Oculta la barra superior (p. ej. en la pantalla de login). */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const admin = Astro.locals.admin;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Admin · NEXUSSTORE</title>
  </head>
  <body class="bg-nexus-background text-nexus-text min-h-screen font-sans">
    {
      !bare && (
        <header class="border-nexus-surface bg-nexus-background sticky top-0 z-50 border-b">
          <div class="container mx-auto flex h-16 items-center justify-between px-4 lg:px-6">
            <div class="flex items-center gap-6">
              <a href="/admin" class="flex flex-col items-start gap-0.5 leading-none">
                <span class="font-display text-lg font-black tracking-widest text-white uppercase">
                  NEXUS
                </span>
                <span class="text-nexus-primary text-[0.55rem] font-bold tracking-[0.35em] uppercase">
                  Admin
                </span>
              </a>
              <nav class="flex items-center gap-4">
                <a
                  href="/admin"
                  class="text-nexus-muted text-xs font-bold tracking-widest uppercase transition-colors hover:text-white"
                >
                  Catálogo
                </a>
                <a
                  href="/admin/orders"
                  class="text-nexus-muted text-xs font-bold tracking-widest uppercase transition-colors hover:text-white"
                >
                  Pedidos
                </a>
                <a
                  href="/"
                  class="text-nexus-muted text-xs font-bold tracking-widest uppercase transition-colors hover:text-white"
                >
                  Ver tienda ↗
                </a>
              </nav>
            </div>

            <div class="flex items-center gap-4">
              {admin && (
                <span class="text-nexus-muted hidden text-xs sm:inline">
                  {admin.email}
                </span>
              )}
              <form method="POST" action="/api/admin/logout">
                <button
                  type="submit"
                  class="border-nexus-surface text-nexus-muted rounded-lg border px-4 py-2 text-xs font-bold tracking-widest uppercase transition-colors hover:border-white hover:text-white"
                >
                  Salir
                </button>
              </form>
            </div>
          </div>
        </header>
      )
    }

    <main class="container mx-auto px-4 py-10 lg:px-6">
      <slot />
    </main>
  </body>
</html>
