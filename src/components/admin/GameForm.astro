---
import {
  GENRE_OPTIONS,
  PLATFORM_OPTIONS,
  TAG_OPTIONS,
  type GameFormValues,
} from "../../lib/admin-form";

interface Props {
  values: GameFormValues;
  errors: Record<string, string>;
  action: string;
  submitLabel: string;
  /** En edición el slug es la clave: se muestra pero no se edita. */
  mode: "new" | "edit";
}

const { values, errors, action, submitLabel, mode } = Astro.props;

const inputClass =
  "border-nexus-surface bg-nexus-surface/30 text-nexus-text placeholder:text-nexus-muted/60 focus:border-nexus-primary w-full rounded-lg border px-4 py-3 text-sm focus:outline-none";
const labelClass =
  "text-nexus-muted mb-2 block text-xs font-bold tracking-widest uppercase";
const errClass = "text-nexus-accent mt-1 text-xs";
---

<form method="POST" action={action} class="space-y-6">
  {
    errors.form && (
      <p class="border-nexus-accent bg-nexus-accent/10 text-nexus-accent rounded-lg border px-4 py-3 text-sm">
        {errors.form}
      </p>
    )
  }

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label for="title" class={labelClass}>Título</label>
      <input
        id="title"
        name="title"
        type="text"
        value={values.title}
        required
        class={inputClass}
      />
      {errors.title && <p class={errClass}>{errors.title}</p>}
    </div>

    <div>
      <label for="edition" class={labelClass}>Edición</label>
      <input
        id="edition"
        name="edition"
        type="text"
        value={values.edition}
        placeholder="Standard Edition"
        required
        class={inputClass}
      />
      {errors.edition && <p class={errClass}>{errors.edition}</p>}
    </div>
  </div>

  <div>
    <label for="slug" class={labelClass}>
      Slug {mode === "new" ? "(opcional — se deriva del título)" : "(fijo)"}
    </label>
    <input
      id="slug"
      name="slug"
      type="text"
      value={values.slug}
      readonly={mode === "edit"}
      placeholder="neon-drift"
      class={`${inputClass} ${mode === "edit" ? "opacity-60" : ""}`}
    />
    {errors.slug && <p class={errClass}>{errors.slug}</p>}
  </div>

  <div>
    <label for="description" class={labelClass}>Descripción</label>
    <textarea
      id="description"
      name="description"
      rows="4"
      required
      class={inputClass}>{values.description}</textarea
    >
    {errors.description && <p class={errClass}>{errors.description}</p>}
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div>
      <label for="price" class={labelClass}>Precio (USD)</label>
      <input
        id="price"
        name="price"
        type="number"
        step="0.01"
        min="0"
        value={values.price}
        required
        class={inputClass}
      />
      {errors.price && <p class={errClass}>{errors.price}</p>}
    </div>
    <div>
      <label for="discountPercent" class={labelClass}>Descuento % (1–90)</label>
      <input
        id="discountPercent"
        name="discountPercent"
        type="number"
        min="1"
        max="90"
        value={values.discountPercent}
        placeholder="—"
        class={inputClass}
      />
      {errors.discountPercent && <p class={errClass}>{errors.discountPercent}</p>}
    </div>
    <div>
      <label for="tag" class={labelClass}>Etiqueta</label>
      <select id="tag" name="tag" class={inputClass}>
        {
          TAG_OPTIONS.map((tag) => (
            <option value={tag} selected={values.tag === tag}>
              {tag === "" ? "— ninguna —" : tag}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <fieldset>
    <legend class={labelClass}>Géneros</legend>
    <div class="flex flex-wrap gap-3">
      {
        GENRE_OPTIONS.map((genre) => (
          <label class="border-nexus-surface flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm">
            <input
              type="checkbox"
              name="genres"
              value={genre.value}
              checked={values.genres.includes(genre.value)}
            />
            {genre.label}
          </label>
        ))
      }
    </div>
    {errors.genres && <p class={errClass}>{errors.genres}</p>}
  </fieldset>

  <fieldset>
    <legend class={labelClass}>Plataformas</legend>
    <div class="flex flex-wrap gap-3">
      {
        PLATFORM_OPTIONS.map((platform) => (
          <label class="border-nexus-surface flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm">
            <input
              type="checkbox"
              name="platforms"
              value={platform}
              checked={values.platforms.includes(platform)}
            />
            {platform}
          </label>
        ))
      }
    </div>
    {errors.platforms && <p class={errClass}>{errors.platforms}</p>}
  </fieldset>

  <div class="flex flex-wrap gap-4">
    {
      (
        [
          ["isNew", "Nuevo lanzamiento (slider)"],
          ["featured", "Destacado (hero)"],
          ["preorder", "Pre-order"],
        ] as const
      ).map(([name, label]) => (
        <label class="flex cursor-pointer items-center gap-2 text-sm">
          <input type="checkbox" name={name} checked={values[name]} />
          {label}
        </label>
      ))
    }
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label for="developer" class={labelClass}>Desarrollador</label>
      <input
        id="developer"
        name="developer"
        type="text"
        value={values.developer}
        required
        class={inputClass}
      />
      {errors.developer && <p class={errClass}>{errors.developer}</p>}
    </div>
    <div>
      <label for="releaseDate" class={labelClass}>Fecha de lanzamiento</label>
      <input
        id="releaseDate"
        name="releaseDate"
        type="text"
        value={values.releaseDate}
        placeholder="Jan 17, 2025"
        required
        class={inputClass}
      />
      {errors.releaseDate && <p class={errClass}>{errors.releaseDate}</p>}
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div>
      <label for="rating" class={labelClass}>Clasificación</label>
      <input
        id="rating"
        name="rating"
        type="text"
        value={values.rating}
        placeholder="E for Everyone"
        required
        class={inputClass}
      />
      {errors.rating && <p class={errClass}>{errors.rating}</p>}
    </div>
    <div>
      <label for="systemReqMin" class={labelClass}>Espacio mínimo</label>
      <input
        id="systemReqMin"
        name="systemReqMin"
        type="text"
        value={values.systemReqMin}
        placeholder="12 GB"
        required
        class={inputClass}
      />
      {errors.systemReqMin && <p class={errClass}>{errors.systemReqMin}</p>}
    </div>
    <div>
      <label for="systemReqRec" class={labelClass}>Espacio recomendado</label>
      <input
        id="systemReqRec"
        name="systemReqRec"
        type="text"
        value={values.systemReqRec}
        placeholder="20 GB"
        required
        class={inputClass}
      />
      {errors.systemReqRec && <p class={errClass}>{errors.systemReqRec}</p>}
    </div>
  </div>

  <div>
    <label for="image" class={labelClass}>URL de la imagen principal</label>
    <input
      id="image"
      name="image"
      type="url"
      value={values.image}
      placeholder="https://images.unsplash.com/..."
      required
      class={inputClass}
    />
    {errors.image && <p class={errClass}>{errors.image}</p>}
  </div>

  <div>
    <label for="gallery" class={labelClass}>
      Galería — una URL por línea (opcional)
    </label>
    <textarea id="gallery" name="gallery" rows="3" class={inputClass}
      >{values.gallery}</textarea
    >
    {errors.gallery && <p class={errClass}>{errors.gallery}</p>}
  </div>

  <div class="flex items-center gap-4 pt-2">
    <button
      type="submit"
      class="bg-nexus-primary text-nexus-background shadow-neon-lime rounded-lg px-6 py-3.5 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white"
    >
      {submitLabel}
    </button>
    <a
      href="/admin"
      class="text-nexus-muted text-xs font-bold tracking-widest uppercase transition-colors hover:text-white"
    >
      Cancelar
    </a>
  </div>
</form>
