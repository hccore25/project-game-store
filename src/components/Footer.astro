---
---
<footer class="bg-[#0B0E14] relative pt-12 pb-6 border-t border-nexus-surface overflow-hidden mt-16">
    <!-- Glow line separator over border -->
    <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-nexus-cyan/40 to-transparent"></div>

    <div class="container mx-auto px-4 lg:px-8">
        <!-- Main Footer Content -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-12 mb-10">
            
            <!-- Logo Section -->
            <div class="flex items-center gap-6">
                <!-- Logo Nexus Games -->
                <a href="/" class="flex flex-col items-center justify-center leading-none gap-0.5">
                    <span class="text-3xl font-display font-black text-white tracking-widest uppercase">NEXUS</span>
                    <span class="text-[0.7rem] font-bold text-nexus-purple tracking-[0.4em] uppercase">GAMES</span>
                </a>
                
                <p class="text-nexus-muted text-[13px] border-l border-nexus-surface/50 pl-6 py-2 hidden sm:block">
                    &copy; {new Date().getFullYear()} NEXUS GAMES. Explore limitless worlds.
                </p>
            </div>
            
            <p class="text-nexus-muted text-[13px] sm:hidden">
                &copy; {new Date().getFullYear()} NEXUS GAMES. Explore limitless worlds.
            </p>

            <!-- Menu Links -->
            <div class="flex flex-wrap md:flex-nowrap gap-12 lg:gap-24 w-full md:w-auto justify-between lg:justify-end">
                
                <!-- Help -->
                <div>
                    <h3 class="text-nexus-purple font-bold text-sm mb-4 tracking-widest uppercase">HELP</h3>
                    <ul class="space-y-3 text-[15px]">
                        <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors">FAQ</a></li>
                        <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors">Contact</a></li>
                        <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors">Support</a></li>
                    </ul>
                </div>
                
                <!-- Legal -->
                <div>
                    <h3 class="text-nexus-purple font-bold text-sm mb-4 tracking-widest uppercase">LEGAL</h3>
                    <ul class="space-y-3 text-[15px]">
                        <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors">Terms</a></li>
                        <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors">Privacy</a></li>
                        <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors border-b border-nexus-surface pb-0.5">Cookies</a></li>
                    </ul>
                </div>

                <!-- Connect / Socials -->
                <div class="flex items-start gap-12">
                    <div class="hidden sm:block">
                        <h3 class="text-nexus-cyan font-bold text-sm mb-4 tracking-widest uppercase">CONNECT</h3>
                        <ul class="space-y-3 text-[15px]">
                            <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors border-b border-nexus-surface pb-0.5">Twitter</a></li>
                            <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors border-b border-nexus-surface pb-0.5">Discord</a></li>
                            <li><a href="#" class="text-white hover:text-nexus-cyan transition-colors">Instagram</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <!-- Icons & Scroll Top -->
            <div class="flex items-center gap-4 mt-4 md:mt-0 self-start md:self-center">
                <a href="#" class="text-nexus-cyan hover:text-white transition-colors p-1" aria-label="Twitter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
                </a>
                <a href="#" class="text-nexus-cyan hover:text-white transition-colors p-1" aria-label="Discord">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.82 2.41c5.92 1.35 9.18 5.76 9.18 5.76-1.84-3.14-5.18-4.32-5.18-4.32-6-2.16-11.53 1.25-11.53 1.25-1.57.94-2.82 2.37-3.69 4.14C.94 13.9.23 19.33 1.5 23.63c.53 1.83 2 3.86 4.3 4.11 0 0 1.21-1.37 2.18-2.61-2.9-.84-4-2.58-4-2.58 2.38 1.58 4.7 2.18 7.35 2.5 3 .37 6.13-.19 8.94-1.63.15-.08.3-.15.44-.24-.04.05-.09.11-.14.16-3.05 2.56-6.62 3.39-6.62 3.39 1.44 1.7 4.54 3.47 7.02 3.39 2.14-.07 3.52-1.92 3.98-3.52 1.58-5.32.74-11.23-2.15-16.14-.94-1.6-2.07-2.9-3.54-3.87-2.3-1.55-5.34-2.63-8.8-2.73 0 0-1.8.1-1.8.1z"/><circle cx="8" cy="15" r="2"/><circle cx="16" cy="15" r="2"/></svg>
                </a>
                <a href="#" class="text-nexus-cyan hover:text-white transition-colors p-1" aria-label="Instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                </a>
                
                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="bg-nexus-purple hover:bg-white hover:text-nexus-purple text-white p-2 rounded-lg ml-4 shadow-[0_0_10px_rgba(124,58,237,0.5)] transition-all flex items-center justify-center relative" aria-label="Volver arriba">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up"><path d="m18 15-6-6-6 6"/></svg>
                    <!-- Estrellita decorativa derecha -->
                    <span class="absolute -right-6 top-1/2 transform -translate-y-1/2 text-white/50 text-2xl hidden md:block">✦</span>
                </button>
            </div>
            
        </div>
    </div>
</footer>
