---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import GameForm from "../../../components/admin/GameForm.astro";
import {
  emptyGameForm,
  parseGameForm,
  readGameForm,
} from "../../../lib/admin-form";
import { createGame, gameExists } from "../../../lib/games";

export const prerender = false;

let values = emptyGameForm();
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  values = readGameForm(await Astro.request.formData());
  const result = parseGameForm(values);

  if (!result.ok) {
    errors = result.errors;
  } else if (await gameExists(result.slug)) {
    errors = { slug: `Ya existe un juego con el slug «${result.slug}».` };
  } else {
    await createGame(result.slug, result.data!);
    return Astro.redirect(`/admin?created=${result.slug}`, 303);
  }
}
---

<AdminLayout title="Nuevo juego">
  <a
    href="/admin"
    class="text-nexus-muted mb-6 inline-block text-sm font-bold tracking-widest uppercase transition-colors hover:text-white"
  >
    ← Catálogo
  </a>
  <h1
    class="font-display mb-8 text-2xl font-black tracking-widest text-white uppercase"
  >
    Nuevo juego
  </h1>

  <GameForm
    values={values}
    errors={errors}
    action="/admin/games/new"
    submitLabel="Crear juego"
    mode="new"
  />
</AdminLayout>
