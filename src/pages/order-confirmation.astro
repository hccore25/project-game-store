---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Order Confirmed" description="Your simulated order is ready.">
  <div class="container mx-auto max-w-3xl px-4 py-8 lg:px-6">
    <!-- No recent order -->
    <div
      id="order-empty"
      class="border-nexus-surface hidden flex-col items-center gap-6 rounded-2xl border border-dashed p-16 text-center"
    >
      <Icon name="search" size={48} class="text-nexus-muted" />
      <p class="font-display text-xl font-bold text-white">
        No recent order found
      </p>
      <a
        href="/#store"
        class="bg-nexus-primary text-nexus-background shadow-neon-lime rounded-lg px-8 py-3.5 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white"
      >
        BACK TO STORE
      </a>
    </div>

    <!-- Confirmation -->
    <div id="order-content" class="hidden">
      <div class="mb-10 flex flex-col items-center gap-4 text-center">
        <div
          class="bg-nexus-primary/20 text-nexus-primary shadow-neon-lime flex h-20 w-20 items-center justify-center rounded-full"
        >
          <Icon name="check" size={40} strokeWidth={3} />
        </div>
        <h1
          class="font-display text-3xl font-black tracking-widest text-white uppercase"
        >
          ORDER CONFIRMED
        </h1>
        <p class="text-nexus-muted text-sm">
          Order <span id="order-id" class="text-nexus-accent font-bold"></span>
          · <span id="order-date"></span>
        </p>
        <p class="text-nexus-muted max-w-md text-sm">
          This is a demo order — no payment was processed. Your game keys are
          below and were also "sent" to your email.
        </p>
      </div>

      <ul id="order-items" class="space-y-4"></ul>

      <div
        class="border-nexus-surface mt-8 flex justify-between border-t pt-6 text-lg"
      >
        <span class="font-bold text-white">Total paid</span>
        <span
          id="order-total"
          class="text-nexus-primary font-display font-black"></span>
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/#store"
          class="bg-nexus-primary text-nexus-background shadow-neon-lime rounded-lg px-8 py-3.5 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:bg-white"
        >
          BACK TO STORE
        </a>
      </div>
    </div>
  </div>

  <!-- Plantilla de ítem de la orden -->
  <template id="order-item-template">
    <li class="border-nexus-surface bg-nexus-surface/20 rounded-xl border p-4">
      <div class="flex items-center gap-4">
        <img
          class="item-image h-16 w-12 shrink-0 rounded-lg object-cover"
          alt=""
        />
        <div class="min-w-0 flex-1">
          <h3 class="item-title font-display truncate font-bold text-white">
          </h3>
          <span class="item-meta text-nexus-muted text-sm"></span>
        </div>
      </div>
      <ul class="item-keys mt-4 space-y-2"></ul>
    </li>
  </template>

  <script>
    import { getLastOrder } from "../utils/store";
    import { formatPrice } from "../utils/format";

    const order = getLastOrder();
    const emptyState = document.getElementById("order-empty");
    const content = document.getElementById("order-content");
    const template = document.getElementById(
      "order-item-template",
    ) as HTMLTemplateElement | null;

    if (!order) {
      emptyState?.classList.remove("hidden");
      emptyState?.classList.add("flex");
    } else if (content && template) {
      content.classList.remove("hidden");

      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };

      set("order-id", order.id);
      set(
        "order-date",
        new Date(order.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        }),
      );
      set("order-total", formatPrice(order.total));

      const list = document.getElementById("order-items");
      for (const item of order.items) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const li = node.querySelector("li")!;

        const image = li.querySelector(".item-image") as HTMLImageElement;
        image.src = item.image;
        image.alt = item.title;

        li.querySelector(".item-title")!.textContent = item.title;
        li.querySelector(".item-meta")!.textContent =
          `${item.qty} × ${formatPrice(item.price)}`;

        const keysList = li.querySelector(".item-keys")!;
        for (const key of item.keys) {
          const keyItem = document.createElement("li");
          keyItem.className =
            "bg-nexus-background border-nexus-teal text-nexus-primary rounded-lg border px-4 py-2 font-mono text-sm tracking-[0.2em]";
          keyItem.textContent = key;
          keysList.append(keyItem);
        }

        list?.append(li);
      }
    }
  </script>
</Layout>
