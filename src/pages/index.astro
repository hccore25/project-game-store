---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import GameCard from "../components/GameCard.astro";
import GameSliderCard from "../components/GameSliderCard.astro";
import GenreCard from "../components/GenreCard.astro";
import HeroSlider from "../components/HeroSlider.astro";
import { genres } from "../data/genres";
import { listGames, listHeroGames } from "../lib/games";

// Renderizado on-demand: el catálogo se lee de la base de datos en cada
// visita, así los cambios del panel de administración se ven al instante.
export const prerender = false;

const allGames = await listGames();

// Sin catálogo (base recién creada y sin sembrar) no hay hero que mostrar:
// degradamos con un aviso en vez de romper con un 500.
if (allGames.length === 0) {
  return new Response(
    `<!doctype html><meta charset="utf-8"><title>Catálogo vacío</title>
     <body style="font-family:system-ui;background:#0c1618;color:#ece5f0;padding:3rem;max-width:40rem;margin:auto">
     <h1>El catálogo está vacío</h1>
     <p>Sembrá los juegos de ejemplo con <code>pnpm db:seed</code> o agregá el primero desde
     <a style="color:#9fcc2e" href="/admin">/admin</a>.</p>`,
    { status: 200, headers: { "Content-Type": "text/html; charset=utf-8" } },
  );
}

const heroGames = await listHeroGames();
const newGames = allGames.filter((game) => game.data.isNew);
const deals = allGames
  .filter((game) => game.data.discountPercent)
  .sort(
    (a, b) => (b.data.discountPercent ?? 0) - (a.data.discountPercent ?? 0),
  );
const catalog = [...allGames].sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

// Juegos visibles en móvil antes del botón "See more"
const MOBILE_INITIAL_GAMES = 3;
---

<Layout title="Explore Limitless Worlds">
  <div class="container mx-auto space-y-16 px-4 py-8 lg:px-6">
    <!-- Hero Slider -->
    <HeroSlider games={heroGames} />

    <!-- EXPLORE BY GENRE -->
    <section id="genres">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        EXPLORE BY GENRE
      </h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:gap-6">
        {genres.map((genre) => <GenreCard genre={genre} />)}
      </div>
    </section>

    <!-- NEW RELEASES SLIDER (solo si hay juegos marcados como "nuevo") -->
    {
      newGames.length > 0 && (
        <section>
          <h2 class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase">
            NEW RELEASES
          </h2>
          <div
            class="splide group/slider relative w-full"
            id="new-games-slider"
            aria-label="New releases"
          >
            {/* Flechas: siempre visibles (en touch no hay hover), con énfasis
                extra al pasar el cursor. */}
            <div class="splide__arrows pointer-events-none absolute inset-y-0 right-0 left-0 z-10 md:-mx-6">
              <button class="splide__arrow splide__arrow--prev bg-nexus-primary border-nexus-surface hover:bg-nexus-accent hover:shadow-neon-peach text-nexus-background pointer-events-auto absolute top-1/2 -left-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 opacity-80 transition-all duration-300 group-hover/slider:opacity-100 md:-left-8 md:h-16 md:w-16 md:border-4">
                <Icon name="chevron-left" size={24} strokeWidth={3} />
              </button>
              <button class="splide__arrow splide__arrow--next bg-nexus-primary border-nexus-surface hover:bg-nexus-accent hover:shadow-neon-peach text-nexus-background pointer-events-auto absolute top-1/2 -right-4 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 opacity-80 transition-all duration-300 group-hover/slider:opacity-100 md:-right-8 md:h-16 md:w-16 md:border-4">
                <Icon name="chevron-right" size={24} strokeWidth={3} />
              </button>
            </div>

            <div class="splide__track w-full pb-10">
              <ul class="splide__list">
                {newGames.map((game) => (
                  <li class="splide__slide">
                    <GameSliderCard game={game} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    <!-- HOT DEALS -->
    <section id="deals">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        HOT DEALS
      </h2>
      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-4 lg:gap-6"
      >
        {deals.map((game) => <GameCard game={game} />)}
      </div>
    </section>

    <!-- ALL GAMES -->
    <section id="store">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        ALL GAMES
      </h2>
      <div
        id="catalog-grid"
        class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-4 lg:gap-6"
      >
        {
          catalog.map((game, index) => (
            <div
              class={`catalog-item ${index >= MOBILE_INITIAL_GAMES ? "hidden md:block" : ""}`}
            >
              <GameCard game={game} />
            </div>
          ))
        }
      </div>

      <!-- Ver más (solo móvil; en md+ el grid muestra todo) -->
      <div id="see-more-wrapper" class="mt-6 flex justify-center md:hidden">
        <button
          id="see-more-btn"
          class="border-nexus-primary text-nexus-primary hover:bg-nexus-primary hover:text-nexus-background flex items-center gap-2 rounded-lg border px-8 py-3 text-sm font-bold tracking-widest uppercase transition-all duration-300"
        >
          SEE MORE
          <Icon name="chevron-down" size={16} />
        </button>
      </div>

      <!-- Sin JS, el catálogo completo queda visible -->
      <noscript>
        <style>
          .catalog-item {
            display: block !important;
          }
          #see-more-wrapper {
            display: none !important;
          }
        </style>
      </noscript>
    </section>
  </div>
</Layout>

<script>
  import Splide from "@splidejs/splide";
  import "@splidejs/splide/css/core";

  // Slider de nuevos lanzamientos (los scripts de Astro corren como módulos
  // después de parsear el DOM, no hace falta esperar a DOMContentLoaded)
  const sliderEl = document.getElementById("new-games-slider");

  if (sliderEl) {
    // Sin autoplay si el usuario prefiere movimiento reducido
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    new Splide(sliderEl, {
      type: "loop",
      perPage: 1,
      perMove: 1,
      gap: "24px",
      pagination: true,
      arrows: true,
      autoplay: !reducedMotion,
      interval: 4000,
      pauseOnHover: true,
    }).mount();
  }

  // --- "See more" del catálogo en móvil ---
  // Revela las tarjetas ocultas por tandas y oculta el botón al terminar
  const SEE_MORE_BATCH = 4;
  const seeMoreBtn = document.getElementById("see-more-btn");
  const seeMoreWrapper = document.getElementById("see-more-wrapper");

  if (seeMoreBtn && seeMoreWrapper) {
    seeMoreBtn.addEventListener("click", () => {
      const hiddenItems = document.querySelectorAll(
        "#catalog-grid .catalog-item.hidden",
      );

      [...hiddenItems]
        .slice(0, SEE_MORE_BATCH)
        .forEach((item) => item.classList.remove("hidden"));

      if (hiddenItems.length <= SEE_MORE_BATCH) {
        seeMoreWrapper.classList.add("hidden");
      }
    });
  }
</script>
