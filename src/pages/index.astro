const newGames = [
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image:
      "https://images.unsplash.com/photo-1614729939124-032f0b5609ce?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "NEW RELEASE",
    tagColor: "bg-nexus-purple shadow-neon-purple",
    platforms: ["PC", "PS"],
  },
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image:
      "https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "NEW RELEASE",
    tagColor: "bg-nexus-purple shadow-neon-purple",
    platforms: ["PC", "PS"],
  },
  {
    title: "The Last Kingdom",
    edition: "Enhanced Edition",
    image:
      "https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "BESTSELLER",
    tagColor: "bg-nexus-cyan shadow-[0_0_10px_rgba(6,182,212,0.8)] text-black",
    platforms: ["PC", "PS"],
  },
];

const genres = [
  { name: "RPG", icon: "shield" },
  { name: "ACTION-ADV", icon: "swords" },
  { name: "STRATEGY", icon: "users" },
  { name: "INDIE", icon: "gamepad-2" },
];
---

<Layout title="Explore Limitless Worlds">
  <!-- Outer Container for Page Content -->
  <div class="container mx-auto px-4 py-8 lg:px-6">
    <!-- Hero Section/Banner -->
    <section
      class="bg-nexus-surface border-nexus-surface/80 relative mb-16 flex h-[500px] flex-col items-stretch overflow-hidden rounded-[2rem] border shadow-lg md:flex-row"
    >
      <!-- Hero Content (Left) -->
      <div
        class="from-nexus-background via-nexus-background/95 relative z-10 flex flex-1 flex-col justify-center bg-gradient-to-r to-transparent p-10 md:p-16"
      >
        <h1
          class="font-display mb-4 text-4xl leading-[1.1] font-black tracking-tight text-white md:text-5xl lg:text-6xl"
        >
          A NEW ERA OF<br />ADVENTURE BEGINS.
        </h1>
        <p
          class="text-nexus-muted mb-10 max-w-md text-lg font-medium md:text-xl"
        >
          Explore limitless worlds. Pre-order Chrono-Break today.
        </p>
        <div>
          <button
            class="bg-nexus-purple hover:text-nexus-purple shadow-neon-purple rounded-lg px-8 py-3.5 text-sm font-bold tracking-widest text-white uppercase transition-all hover:bg-white"
          >
            PRE-ORDER NOW
          </button>
        </div>
      </div>

      <!-- Hero Image (Right) -->
      <div class="absolute inset-0 h-full md:relative md:inset-auto md:w-3/5">
        <!-- Using an illustration/game character placeholder -->
        <img
          src="https://images.unsplash.com/photo-1618336753974-aae8e04506aa?q=80&w=1200&auto=format&fit=crop"
          alt="Chrono-Break Character"
          class="h-full w-full object-cover object-right-top"
        />
        <div
          class="from-nexus-background absolute inset-0 bg-gradient-to-t via-transparent to-transparent md:hidden"
        >
        </div>
        <div
          class="from-nexus-background via-nexus-background/50 absolute inset-0 hidden bg-gradient-to-r to-transparent md:block"
        >
        </div>
        <!-- Some glow overlay -->
        <div class="bg-nexus-purple/10 absolute inset-0 mix-blend-color-dodge">
        </div>
      </div>
    </section>

    <!-- EXPLORE BY GENRE -->
    <section class="mb-16">
      <h2
        class="font-display mb-6 text-xl font-black tracking-widest text-white uppercase"
      >
        EXPLORE BY GENRE
      </h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:gap-6">
        {/* Shield RPG */}
        <a
          href="#"
          class="bg-nexus-surface hover:bg-nexus-surface/80 hover:border-nexus-cyan group hover:shadow-neon-cyan flex flex-col items-center justify-center gap-4 rounded-2xl border border-transparent p-6 transition-all duration-300"
        >
          <div class="text-nexus-cyan">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-swords drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] transition-all transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12 group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)]"
              ><path
                d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2-1 4-2 7-2 2.5 0 4.5 1 6.5 2a1 1 0 0 1 1 1z"
              ></path></svg
            >
          </div>
          <span class="text-center text-sm font-bold tracking-widest text-white"
            >RPG</span
          >
        </a>

        {/* Swords Action-Adv */}
        <a
          href="#"
          class="bg-nexus-surface hover:bg-nexus-surface/80 hover:border-nexus-cyan group hover:shadow-neon-cyan flex flex-col items-center justify-center gap-4 rounded-2xl border border-transparent p-6 transition-all duration-300"
        >
          <div class="text-nexus-cyan">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-swords drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] transition-all transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12 group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)]"
              ><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"
              ></polyline><line x1="13" x2="19" y1="19" y2="13"></line><line
                x1="16"
                x2="20"
                y1="16"
                y2="20"></line><line x1="19" x2="21" y1="21" y2="19"
              ></line><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"
              ></polyline><line x1="5" x2="9" y1="14" y2="18"></line><line
                x1="7"
                x2="4"
                y1="17"
                y2="20"></line><line x1="3" x2="5" y1="19" y2="21"></line></svg
            >
          </div>
          <span class="text-center text-sm font-bold tracking-widest text-white"
            >ACTION-ADV</span
          >
        </a>

        {/* Users Strategy */}
        <a
          href="#"
          class="bg-nexus-surface hover:bg-nexus-surface/80 hover:border-nexus-cyan group hover:shadow-neon-cyan flex flex-col items-center justify-center gap-4 rounded-2xl border border-transparent p-6 transition-all duration-300"
        >
          <div class="text-nexus-cyan">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="currentColor"
              fill-opacity="0.2"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-users drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] transition-all transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12 group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)]"
              ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
              ></path><circle cx="9" cy="7" r="4"></circle><path
                d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
                d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
          </div>
          <span class="text-center text-sm font-bold tracking-widest text-white"
            >STRATEGY</span
          >
        </a>

        {/* Gamepad Indie */}
        <a
          href="#"
          class="bg-nexus-surface hover:bg-nexus-surface/80 hover:border-nexus-cyan group hover:shadow-neon-cyan flex flex-col items-center justify-center gap-4 rounded-2xl border border-transparent p-6 transition-all duration-300"
        >
          <div class="text-nexus-cyan">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="currentColor"
              fill-opacity="0.2"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-gamepad-2 drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] transition-all transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12 group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)]"
              ><line x1="6" x2="10" y1="12" y2="12"></line><line
                x1="8"
                x2="8"
                y1="10"
                y2="14"></line><line x1="15" x2="15.01" y1="13" y2="13"
              ></line><line x1="18" x2="18.01" y1="11" y2="11"></line><rect
                width="20"
                height="12"
                x="2"
                y="6"
                rx="2"></rect></svg
            >
          </div>
          <span class="text-center text-sm font-bold tracking-widest text-white"
            >INDIE</span
          >
        </a>
      </div>
    </section>

    <!-- NEW GAMES GRID -->
    <section>
      <div
        class="mb-[50px] grid grid-cols-1 gap-4 md:mb-[100px] md:grid-cols-2 lg:grid-cols-3 lg:gap-6"
      >
        {
          newGames.map((game) => (
            <div class="group border-nexus-surface hover:border-nexus-purple relative w-full overflow-hidden rounded-2xl border bg-[#0B0E14] transition-all duration-300 hover:shadow-[0_0_15px_rgba(124,58,237,0.3)]">
              <div class="relative h-64 overflow-hidden rounded-t-xl">
                <img
                  src={game.image}
                  alt={game.title}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 group-hover:rotate-2"
                />
                <span class="bg-nexus-cyan text-nexus-background absolute top-0 left-4 translate-y-[-200%] rounded-b-md px-3 py-1 text-[10px] font-bold tracking-widest transition-transform duration-500 group-hover:translate-y-0">
                  NUEVO
                </span>
              </div>

              <div class="p-6">
                <h3 class="font-display text-nexus-text group-hover:text-nexus-purple text-lg transition-colors duration-300">
                  {game.title}
                </h3>

                <p class="text-nexus-muted mt-2 line-clamp-2 text-sm opacity-80 transition-opacity duration-300 group-hover:opacity-100">
                  {game.edition}
                </p>

                <div class="mt-6 flex items-center justify-between">
                  <span class="text-nexus-green text-2xl font-bold">
                    {game.price}
                  </span>

                  <button class="bg-nexus-purple hover:shadow-neon-purple flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-bold text-white transition-all duration-300 hover:ring-2 hover:ring-purple-400 active:scale-95">
                    COMPRAR
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="group-hover:border-nexus-purple/30 pointer-events-none absolute inset-0 rounded-2xl border-2 border-transparent transition-colors duration-500" />
            </div>
          ))
        }
      </div>
    </section>

    <!-- GAMES GRID -->
    <section>
      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-4 lg:gap-6"
      >
        {
          games.map((game) => (
            <a
              href="/game/aetherbound-shattered-stars"
              class="group border-nexus-surface hover:border-nexus-purple block flex h-full flex-col overflow-hidden rounded-xl border bg-[#0B0E14] transition-all duration-300 hover:shadow-[0_0_15px_rgba(124,58,237,0.3)]"
            >
              {/* Top Image Area */}
              <div class="relative aspect-[3/4] w-full overflow-hidden">
                <img
                  src={game.image}
                  alt={game.title}
                  class="h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105 group-hover:opacity-100"
                />

                {/* Floating Tag attached to Top (like design) */}
                <div class="absolute top-0 right-4 flex justify-end">
                  <span
                    class={`rounded-b-md px-3 py-1 text-[10px] font-bold tracking-widest ${game.tagColor}`}
                  >
                    {game.tag}
                  </span>
                </div>

                <div class="from-nexus-background absolute inset-0 bg-gradient-to-t via-transparent to-transparent" />
              </div>

              {/* Content Area */}
              <div class="border-nexus-surface relative z-10 -mt-2 flex flex-grow flex-col border-t bg-[#0B0E14] p-4">
                <h3 class="font-display group-hover:text-nexus-purple mb-1 truncate text-lg leading-tight font-bold text-white transition-colors">
                  {game.title}
                </h3>
                <p class="text-nexus-muted mb-auto text-xs font-medium">
                  {game.edition}
                </p>

                <div class="mt-4 flex items-center justify-between">
                  <span class="text-nexus-green text-lg font-bold">
                    {game.price}
                  </span>
                  <div class="text-nexus-muted flex items-center gap-2">
                    {game.platforms.includes("PC") && (
                      <span class="px-1 text-xs leading-none font-bold">
                        PC
                      </span>
                    )}
                    {game.platforms.includes("PS") && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        stroke="none"
                        class="lucide lucide-playstation"
                      >
                        <path
                          d="M22 13h-4v2h2v4h-2v-4h-4v6H2v-2h4v-8H2V9h12V7h4v2h2v4Z"
                          opacity="0.8"
                        />
                      </svg>
                    )}
                  </div>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
