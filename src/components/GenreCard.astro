---
import Icon from "./Icon.astro";
import type { Genre } from "../data/genres";

interface Props {
  genre: Genre;
}

const { genre } = Astro.props;
---

<a
  href={`/#genre-${genre.slug}`}
  class="bg-nexus-surface hover:bg-nexus-surface/80 hover:border-nexus-accent group hover:shadow-neon-peach flex flex-col items-center justify-center gap-4 rounded-2xl border border-transparent p-6 transition-all duration-300"
>
  <div class="text-nexus-accent">
    <Icon
      name={genre.icon}
      size={48}
      class="drop-shadow-[0_0_8px_rgba(246,190,154,0.6)] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12 group-hover:drop-shadow-[0_0_12px_rgba(246,190,154,0.9)]"
    />
  </div>
  <span class="text-center text-sm font-bold tracking-widest text-white">
    {genre.name}
  </span>
</a>
