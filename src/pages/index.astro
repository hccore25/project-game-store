---
import Layout from '../layouts/Layout.astro';

const games = [
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1614729939124-032f0b5609ce?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "NEW RELEASE",
    tagColor: "bg-nexus-purple shadow-neon-purple",
    platforms: ["PC", "PS"]
  },
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "NEW RELEASE",
    tagColor: "bg-nexus-purple shadow-neon-purple",
    platforms: ["PC", "PS"]
  },
  {
    title: "The Last Kingdom",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "BESTSELLER",
    tagColor: "bg-nexus-cyan shadow-[0_0_10px_rgba(6,182,212,0.8)] text-black",
    platforms: ["PC", "PS"]
  },
  {
    title: "The Last Kingdom",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1580234811497-9df7fd2f357e?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "BESTSELLER",
    tagColor: "bg-nexus-cyan shadow-[0_0_10px_rgba(6,182,212,0.8)] text-black",
    platforms: ["PC", "PS"]
  },
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1622285802778-cf560de649a3?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "NEW RELEASE",
    tagColor: "bg-nexus-purple shadow-neon-purple",
    platforms: ["PC"]
  },
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1552820728-8b83bb6b773f?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "BESTSELLER",
    tagColor: "bg-nexus-cyan shadow-[0_0_10px_rgba(6,182,212,0.8)] text-black",
    platforms: ["PS"]
  },
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1605806616949-1e87b487cb2a?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "NEW RELEASE",
    tagColor: "bg-nexus-purple shadow-neon-purple",
    platforms: ["PC", "PS"]
  },
  {
    title: "Stellar Odyssey",
    edition: "Enhanced Edition",
    image: "https://images.unsplash.com/photo-1610056494052-6a4f814e4125?q=80&w=800&auto=format&fit=crop",
    price: "$59.99",
    tag: "BESTSELLER",
    tagColor: "bg-nexus-cyan shadow-[0_0_10px_rgba(6,182,212,0.8)] text-black",
    platforms: ["PC"]
  },
];

const genres = [
    { name: "RPG", icon: "shield" },
    { name: "ACTION-ADV", icon: "swords" },
    { name: "STRATEGY", icon: "users" },
    { name: "INDIE", icon: "gamepad-2" }
];
---

<Layout title="Explore Limitless Worlds">
    
    <!-- Outer Container for Page Content -->
    <div class="container mx-auto px-4 lg:px-6 py-8">
        
        <!-- Hero Section/Banner -->
        <section class="relative bg-nexus-surface rounded-[2rem] overflow-hidden border border-nexus-surface/80 flex flex-col md:flex-row items-stretch mb-16 h-[500px] shadow-lg">
            
            <!-- Hero Content (Left) -->
            <div class="flex-1 p-10 md:p-16 flex flex-col justify-center relative z-10 bg-gradient-to-r from-nexus-background via-nexus-background/95 to-transparent">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-black text-white mb-4 leading-[1.1] tracking-tight">
                    A NEW ERA OF<br/>ADVENTURE BEGINS.
                </h1>
                <p class="text-nexus-muted mb-10 text-lg md:text-xl font-medium max-w-md">
                    Explore limitless worlds. Pre-order Chrono-Break today.
                </p>
                <div>
                    <button class="bg-nexus-purple hover:bg-white hover:text-nexus-purple text-white px-8 py-3.5 rounded-lg font-bold tracking-widest text-sm uppercase transition-all shadow-neon-purple">
                        PRE-ORDER NOW
                    </button>
                </div>
            </div>

            <!-- Hero Image (Right) -->
            <div class="absolute inset-0 md:relative md:inset-auto md:w-3/5 h-full">
                <!-- Using an illustration/game character placeholder -->
                <img src="https://images.unsplash.com/photo-1618336753974-aae8e04506aa?q=80&w=1200&auto=format&fit=crop" alt="Chrono-Break Character" class="w-full h-full object-cover object-right-top" />
                <div class="absolute inset-0 bg-gradient-to-t from-nexus-background via-transparent to-transparent md:hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-nexus-background via-nexus-background/50 to-transparent hidden md:block"></div>
                <!-- Some glow overlay -->
                <div class="absolute inset-0 bg-nexus-purple/10 mix-blend-color-dodge"></div>
            </div>
            
        </section>

        <!-- EXPLORE BY GENRE -->
        <section class="mb-16">
            <h2 class="text-xl font-display font-black text-white mb-6 uppercase tracking-widest">EXPLORE BY GENRE</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
                
                {/* Shield RPG */}
                <a href="#" class="bg-nexus-surface hover:bg-nexus-surface/80 border border-transparent hover:border-nexus-cyan group rounded-2xl p-6 flex flex-col items-center justify-center gap-4 transition-all hover:shadow-neon-cyan duration-300">
                    <div class="text-nexus-cyan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)] transition-all"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2-1 4-2 7-2 2.5 0 4.5 1 6.5 2a1 1 0 0 1 1 1z"/></svg>
                    </div>
                    <span class="text-white font-bold tracking-widest text-sm text-center">RPG</span>
                </a>
                
                {/* Swords Action-Adv */}
                <a href="#" class="bg-nexus-surface hover:bg-nexus-surface/80 border border-transparent hover:border-nexus-cyan group rounded-2xl p-6 flex flex-col items-center justify-center gap-4 transition-all hover:shadow-neon-cyan duration-300">
                    <div class="text-nexus-cyan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-swords drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)] transition-all"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" x2="19" y1="19" y2="13"/><line x1="16" x2="20" y1="16" y2="20"/><line x1="19" x2="21" y1="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" x2="9" y1="14" y2="18"/><line x1="7" x2="4" y1="17" y2="20"/><line x1="3" x2="5" y1="19" y2="21"/></svg>
                    </div>
                    <span class="text-white font-bold tracking-widest text-sm text-center">ACTION-ADV</span>
                </a>

                {/* Users Strategy */}
                <a href="#" class="bg-nexus-surface hover:bg-nexus-surface/80 border border-transparent hover:border-nexus-cyan group rounded-2xl p-6 flex flex-col items-center justify-center gap-4 transition-all hover:shadow-neon-cyan duration-300">
                    <div class="text-nexus-cyan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)] transition-all"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <span class="text-white font-bold tracking-widest text-sm text-center">STRATEGY</span>
                </a>

                {/* Gamepad Indie */}
                <a href="#" class="bg-nexus-surface hover:bg-nexus-surface/80 border border-transparent hover:border-nexus-cyan group rounded-2xl p-6 flex flex-col items-center justify-center gap-4 transition-all hover:shadow-neon-cyan duration-300">
                    <div class="text-nexus-cyan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gamepad-2 drop-shadow-[0_0_8px_rgba(6,182,212,0.8)] group-hover:drop-shadow-[0_0_12px_rgba(6,182,212,1)] transition-all"><line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="15" x2="15.01" y1="13" y2="13"/><line x1="18" x2="18.01" y1="11" y2="11"/><rect width="20" height="12" x="2" y="6" rx="2"/></svg>
                    </div>
                    <span class="text-white font-bold tracking-widest text-sm text-center">INDIE</span>
                </a>
            </div>
        </section>

        <!-- GAMES GRID -->
        <section>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6">
                {games.map(game => (
                    <a href="/game/aetherbound-shattered-stars" class="group border border-nexus-surface rounded-xl overflow-hidden bg-[#0B0E14] hover:border-nexus-purple transition-all duration-300 flex flex-col h-full hover:shadow-[0_0_15px_rgba(124,58,237,0.3)] block">
                        <!-- Top Image Area -->
                        <div class="relative w-full aspect-[3/4] overflow-hidden">
                            <img src={game.image} alt={game.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100" />
                            
                            <!-- Floating Tag attached to Top (like design) -->
                            <div class="absolute top-0 right-4 flex justify-end">
                                <span class={`px-3 py-1 text-[10px] font-bold tracking-widest rounded-b-md ${game.tagColor}`}>
                                    {game.tag}
                                </span>
                            </div>

                            <div class="absolute inset-0 bg-gradient-to-t from-nexus-background via-transparent to-transparent"></div>
                        </div>

                        <!-- Content Area -->
                        <div class="p-4 flex flex-col flex-grow relative border-t border-nexus-surface -mt-2 bg-[#0B0E14] z-10">
                            <h3 class="text-white font-display text-lg font-bold truncate leading-tight mb-1 group-hover:text-nexus-purple transition-colors">{game.title}</h3>
                            <p class="text-nexus-muted text-xs font-medium mb-auto">{game.edition}</p>
                            
                            <div class="flex items-center justify-between mt-4">
                                <span class="text-nexus-green font-bold text-lg">{game.price}</span>
                                <div class="flex items-center gap-2 text-nexus-muted">
                                    {game.platforms.includes("PC") && (
                                        <span class="text-xs font-bold leading-none px-1">PC</span>
                                    )}
                                    {game.platforms.includes("PS") && (
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-playstation"><path d="M22 13h-4v2h2v4h-2v-4h-4v6H2v-2h4v-8H2V9h12V7h4v2h2v4Z" opacity="0.8"/></svg>
                                    )}
                                </div>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>

    </div>
</Layout>
